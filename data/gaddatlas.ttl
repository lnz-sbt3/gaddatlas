    chora:sourceReference "A 182"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00463> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "Mejo piuttosto la fame; e annà pe strada, e sentisse pioviccicà ne li capelli; mejo addormisse a na panchina de lungotevere, a Prati."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 187"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00464> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "« Là, ne li quartieri alti, a via Boncompagni, a via Veneto. »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 189"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00465> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "« Là, ne li quartieri alti, a via Boncompagni, a via Veneto. »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 189"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00466> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "« Ho capito, la pensione Bergèss, » fece Pompeo, pronunziando a suo modo."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 189"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00467> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "« All’ufficio stranieri, Pompè, allo schedario. Pensione Bergesse. E bbuona pesca. »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 189"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00468> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "« E ddomani mattina, Pompè, ve n’iate a spasso a via Veneto. Vuie v’avite a ’ncuntrà l’inglesa pe cumbinazione, c’intendiamo? »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 189"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00469> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "« Chelle guaglione sbarcano a l’Immacolatella a ciento cinquanta pe’ vvota! A ’o molo Beverello! Da ’o Conte Verde! »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 190"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00470> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "« Chelle guaglione sbarcano a l’Immacolatella a ciento cinquanta pe’ vvota! A ’o molo Beverello! Da ’o Conte Verde! »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 190"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00471> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "Vice-commissario ai Frari, i cinque cherubini scarlatti d’una delle sei madonne in trono di Giovan Bellino (Accademia) gli si erano stampati nella memoria."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 191"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00472> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "Ingravallo, poi, aveva letto Norman Douglas oltre che Lawrence: e ne aveva stillato Calabria, Sardegna (ringhiando) come da fiale d’un iperofficiante elisire."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 192"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00473> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "Ingravallo, poi, aveva letto Norman Douglas oltre che Lawrence: e ne aveva stillato Calabria, Sardegna (ringhiando) come da fiale d’un iperofficiante elisire."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 192"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00474> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "Aveva dunque triangolato, in sua geodesia, anche il territorio circèo, cavandone documentata certezza che la Circe non si fosse piazzata poi tanto male a esercitare l’arte sua."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 192"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00475> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "Lui, Norman Douglas, o lui, Lawrence, li riconosceva emergere dalle tre città di Reggio (Calabria), Sassari e Civitavecchia, con gran dispetto dei palermitani."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 192"^^xsd:string .

