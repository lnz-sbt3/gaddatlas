<https://w3id.org/gaddatlas/id/reference/ref_00490> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "« O a li Quattro Cantoni, da l’Aliciaro, de dietro a San Carlo. »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 200"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00492> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "« O a li Quattro Cantoni, da l’Aliciaro, de dietro a San Carlo. »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
