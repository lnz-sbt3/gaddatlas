<https://w3id.org/gaddatlas/id/reference/ref_00521> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "Magia repentina il Soratte, come una rocca di piombo, di cenere."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VIII> ;
    chora:sourceReference "A 210"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00522> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "Di là, da dietro a Tivoli e a Càrsoli, flottiglie di nubi orizzontali tutte arricciolate di cirri s’avventavano l’una dopo l’altra a battaglia."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VIII> ;
    chora:sourceReference "A 210"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00523> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "Di là, da dietro a Tivoli e a Càrsoli, flottiglie di nubi orizzontali tutte arricciolate di cirri s’avventavano l’una dopo l’altra a battaglia."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VIII> ;
    chora:sourceReference "A 210"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00524> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "Bordeggiavano la scogliera cinerina delle montagne degli Equi, la nudità dealbata del Velino, antemurale della Marsica."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VIII> ;
    chora:sourceReference "A 210"^^xsd:string .

