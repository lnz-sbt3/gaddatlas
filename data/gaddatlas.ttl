    chora:sourceReference "A 206"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00513> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "E, quel che importava più, la ditta Ciurlani di Marino."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VIII> ;
    chora:sourceReference "A 207"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00518> a chora:PlaceReference ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio_adelphi> ;
    chora:excerpt "Era l’alba, e più. Le vette dell’Algido, dei Carseolani e dei Velini inopinatamente presenti, grigie."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VIII> ;
    chora:sourceReference "A 210"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00519> a chora:PlaceReference ;
