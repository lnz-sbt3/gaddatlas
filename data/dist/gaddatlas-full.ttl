<https://w3id.org/gaddatlas/id/interpretation/interp_00050> a prov:Entity,
        chora:SpatialInterpretation ;
    prov:wasAttributedTo <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    prov:wasGeneratedBy <https://w3id.org/gaddatlas/id/act/interp_00050> ;
    chora:adoptedByProject true ;
    chora:anchorsToEntity <https://w3id.org/gaddatlas/id/gazetteer/gaz_via_merulana> ;
    chora:annotationMethod "close_reading"^^xsd:string ;
    chora:assignsNarrativeRole chora:Setting ;
    chora:assignsSpatialDetermination chora:Relative ;
    chora:assignsSpatialRelationType chora:Inside ;
    chora:confidence 1.0 ;
    chora:criticalNote "L’espressione «la ben nota architettura» costituisce una perifrasi eufemistica e allusiva riferita al palazzo di via Merulana (civico 219), già più volte menzionato nel romanzo attraverso denominazioni varianti. L’identificazione non è letterale né nominativa, ma si fonda sulla ricorrenza contestuale, sulla focalizzazione interna (Ingravallo) e sul valore di riconoscibilità implicita attribuito al luogo, che assume qui una funzione evocativa e psicologica più che descrittiva o topografica."@it ;
    chora:hasFocalizer <https://w3id.org/gaddatlas/id/focalizer/ingravallo> ;
    chora:interpretsReference <https://w3id.org/gaddatlas/id/reference/ref_00039> ;
    chora:targetsPlace <https://w3id.org/gaddatlas/id/narrativeplace/palazzo_219> .

