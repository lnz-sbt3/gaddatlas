    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/agent/manzotti> ;
    chora:rationale "«Càrsoli» (QP 210) in luogo della grafia corretta Carsòli, «frutto verosimilmente di un'attrazione analogica con la vicina Àrsoli» (Cap. 4, § 4.4, r. 111). Discrepanza di forma registrata, non corretta."@it ;
    chora:sourcePage "254"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/U-0008> a hico:InterpretationAct ;
    dcterms:date "2010"^^xsd:gYear ;
    hico:hasInterpretationCriterion chora:CriticalReading ;
