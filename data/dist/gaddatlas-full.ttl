    skos:altLabel "Relazioni Spaziali Narrative"@it ;
    skos:hasTopConcept chora:Above,
        chora:AdjacentTo,
        chora:Below,
        chora:Between,
        chora:Boundary,
        chora:Contains,
        chora:Facing,
        chora:Inside,
        chora:Near,
        chora:Overlaps,
        chora:RelatedTo,
        chora:Threshold ;
    skos:prefLabel "Narrative Spatial Relations"@en .

