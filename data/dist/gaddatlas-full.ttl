    dcterms:date "2010"^^xsd:gYear ;
    hico:hasInterpretationCriterion chora:CriticalReading ;
    hico:hasInterpretationType chora:IdentificationAssertion ;
    hico:isExtractedFrom <https://w3id.org/gaddatlas/id/source/manzotti_2010> ;
    prov:qualifiedAssociation <https://w3id.org/gaddatlas/id/association/A-0002-readingauthor-manzotti> ;
    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/agent/manzotti> ;
    chora:rationale "La «stazione di Castello» (QP 279) è la stazione dei carabinieri di Castel Savello: Manzotti scioglie così la dizione, contro la lettura immediata Castel Gandolfo (Cap. 4, § 4.4). Lettura adottata dal progetto (LS, 9/10/2026, DC-04)."@it ;
    chora:sourcePage "293"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/L-0001> a hico:InterpretationAct ;
    dcterms:date "2010"^^xsd:gYear ;
    hico:hasInterpretationCriterion chora:ReferentialEvidence ;
    hico:hasInterpretationType chora:LocationAssertion ;
    hico:isExtractedFrom <https://w3id.org/gaddatlas/id/source/manzotti_2010> ;
    prov:qualifiedAssociation <https://w3id.org/gaddatlas/id/association/L-0001-readingauthor-manzotti> ;
    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/agent/manzotti> ;
    chora:rationale "La carta TCI colloca il casale fra le ferrovie Roma–Velletri e Roma–Napoli, all'altezza di Santa Fumia, lungo il fosso di Casale Abbrusciato, come il testo. Coordinate stimate: punto mediano fra le due ferrovie alla latitudine di Borgo Santa Fumia."@it ;
    chora:sourcePage "268–269; Tavv. VI–VII, pp. 300–301"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/L-0002> a hico:InterpretationAct ;
    dcterms:date "2010"^^xsd:gYear ;
    hico:hasInterpretationCriterion chora:ReferentialEvidence ;
