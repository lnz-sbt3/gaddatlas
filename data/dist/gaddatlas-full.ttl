    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio> ;
    chora:attestedForm "Buco a Sant’Ignazzio"@it ;
    chora:excerpt "« Pure ar Buco a Sant’Ignazzio, quarche vorta, che so’ toscani, m’ha detto: propio de la Toscana. »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 200"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00495> a chora:PlaceReference ;
    chora:appearsInWitness <https://w3id.org/gaddatlas/id/witness/qp> ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio> ;
    chora:attestedForm "Villa Porchese"@it ;
    chora:excerpt "« Scusi, mi dire Villa Porchese àu do jo è? E stanno a via Veneto. All’archi de porta Pinciana, stanno! sti fregni. »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 201"^^xsd:string .

