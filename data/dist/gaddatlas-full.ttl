    chora:rationale "L'autorità giudiziaria «era intervenuta […] a via Merulana, indi al Policlinico»."@it ;
    chora:sourcePage "93"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/R-0020> a hico:InterpretationAct ;
