<https://w3id.org/gaddatlas/id/reference/ref_00466> a chora:PlaceReference ;
    chora:appearsInWitness <https://w3id.org/gaddatlas/id/witness/qp> ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio> ;
    chora:attestedForm "pensione Bergèss"@it ;
    chora:excerpt "« Ho capito, la pensione Bergèss, » fece Pompeo, pronunziando a suo modo."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 189"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00467> a chora:PlaceReference ;
