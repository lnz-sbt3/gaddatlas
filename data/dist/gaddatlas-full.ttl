    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "Di quaresima Angeloni e i suoi pari «si contentano lungheggiar Santa Chiara […] imboccheno la Palommella e sfioreno er dedietro ar Panteone»."@it ;
    chora:sourcePage "41"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/R-0014> a hico:InterpretationAct ;
