    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 180"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00449> a chora:PlaceReference ;
