    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "Santarella «era a percorrere sulla sua motocicletta la via provinciale da Marino ad Albano»: il passo dà la strada e la sua direzione, non il tratto percorso."@it ;
    chora:sourcePage "278"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/R-0017> a hico:InterpretationAct ;
