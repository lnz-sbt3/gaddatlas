<https://w3id.org/gaddatlas/id/reference/ref_00432> a chora:PlaceReference ;
    chora:appearsInWitness <https://w3id.org/gaddatlas/id/witness/qp> ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio> ;
    chora:excerpt "Poi, presso a Ciampino o alla Palomba, levava gli occhi: su, su: carovane bianche di nuvole trascorrendo a mezzo marzo nel cielo"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VI> ;
    chora:sourceReference "A 175"^^xsd:string .

