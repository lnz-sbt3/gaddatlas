    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "Santarella «da Rocca di Papa a Castel Savelli, giù: da Rocca Orsina al Monte Nuncupale, su»."@it ;
    chora:sourcePage "173"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/R-0013> a hico:InterpretationAct ;
