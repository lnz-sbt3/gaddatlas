<https://w3id.org/gaddatlas/id/reference/ref_00463> a chora:PlaceReference ;
    chora:appearsInWitness <https://w3id.org/gaddatlas/id/witness/qp> ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio> ;
    chora:excerpt "Mejo piuttosto la fame; e annà pe strada, e sentisse pioviccicà ne li capelli; mejo addormisse a na panchina de lungotevere, a Prati."@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 187"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00464> a chora:PlaceReference ;
