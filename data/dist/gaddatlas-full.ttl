    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "«Oppure a metà le Frattocchie, doveva spengere: al passaggio dell'Appia, o a Ca' Francesi, a Tor Ser Paolo, alla stazione di Ciampino»: luoghi alternativi della fermata."@it ;
    chora:sourcePage "174"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/R-0011> a hico:InterpretationAct ;
