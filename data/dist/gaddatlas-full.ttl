<https://w3id.org/gaddatlas/id/interpretation/interp_00025> a prov:Entity,
        chora:SpatialInterpretation ;
    prov:wasAttributedTo <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    prov:wasGeneratedBy <https://w3id.org/gaddatlas/id/act/interp_00025> ;
    chora:adoptedByProject true ;
    chora:anchorsToEntity <https://w3id.org/gaddatlas/id/gazetteer/gaz_colli_albani> ;
    chora:annotationMethod "close_reading"^^xsd:string ;
    chora:assignsNarrativeRole chora:ProjectedSpace ;
    chora:assignsSpatialDetermination chora:Relative ;
    chora:assignsSpatialRelationType chora:Overlaps ;
    chora:confidence 0.5 ;
    chora:criticalNote "Area paesaggistica vaga e analogica, delimitata dal Tevere e costruita per accumulo descrittivo (castelli, vigne, colli, monti, piane), contrapposta alla città di Roma; spazio percepito e mitizzato da Liliana Balducci. Il Tevere funziona come barriera idrografica e simbolica di separazione tra spazio urbano e spazio campestre, più che come luogo in sé."@it ;
    chora:hasFocalizer <https://w3id.org/gaddatlas/id/focalizer/liliana> ;
    chora:interpretsReference <https://w3id.org/gaddatlas/id/reference/ref_00025> ;
    chora:targetsPlace <https://w3id.org/gaddatlas/id/narrativeplace/area_oltre_tevere> .

