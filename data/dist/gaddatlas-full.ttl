    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "Angeloni e i suoi pari «si avventurano» per via Colonna, piazza de Pietra, via de Pietra fino al Corso."@it ;
    chora:sourcePage "40"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/R-0010> a hico:InterpretationAct ;
    dcterms:date "2026-10-09"^^xsd:date ;
