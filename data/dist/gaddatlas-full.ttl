    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "«A largo Brancaccio, mentre che staveno svortando in via Merulana verso piazza San Giovanni»: il tragitto è in corso."@it ;
    chora:sourcePage "292"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/R-0005> a hico:InterpretationAct ;
    dcterms:date "2026-10-09"^^xsd:date ;
    hico:hasInterpretationCriterion chora:TextualEvidence ;
