    skos:inScheme chora:SpatialRelationTypeScheme ;
    skos:prefLabel "Boundary"@en ;
    skos:topConceptOf chora:SpatialRelationTypeScheme .

chora:Confusion a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "confusione"@it ;
    skos:broader chora:Discrepancy ;
    skos:definition "The text combines or confuses distinct referents."@en ;
    skos:inScheme chora:UncertaintyTypeScheme ;
    skos:prefLabel "Confusion"@en .

chora:Contains a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "A contiene spazialmente B. Relazione inversa di Inside." ;
    rdfs:comment "Inverso di Inside, basato su GeoSPARQL sfContains"@it ;
    skos:altLabel "Contiene"@it ;
    skos:inScheme chora:SpatialRelationTypeScheme ;
    skos:prefLabel "Contains"@en ;
    skos:topConceptOf chora:SpatialRelationTypeScheme .

chora:Facing a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "A sta di fronte a B («in faccia», «rimpetto»): relazione frontale, orientata."@it ;
    skos:altLabel "Di fronte a"@it ;
    skos:inScheme chora:SpatialRelationTypeScheme ;
    skos:prefLabel "Facing"@en ;
    skos:topConceptOf chora:SpatialRelationTypeScheme .

chora:Narrator a owl:Class ;
    rdfs:subClassOf chora:FocalizingAgent ;
    skos:altLabel "Narratore"@it ;
    skos:prefLabel "Narrator"@en .

chora:NonApplicability a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "non-applicabilità"@it ;
    skos:definition "A coordinate or referent does not apply to this occurrence."@en ;
    skos:inScheme chora:UncertaintyTypeScheme ;
    skos:prefLabel "Non Applicability"@en ;
    skos:topConceptOf chora:UncertaintyTypeScheme .

chora:NotApplicable a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "coordinata non applicabile"@it ;
    skos:definition "A coordinate does not apply to the place. It is assigned case by case, never derived from the reality status (D-062)."@en ;
    skos:inScheme chora:LocalizationStatusScheme ;
    skos:prefLabel "Not applicable"@en ;
    skos:topConceptOf chora:LocalizationStatusScheme .

chora:Oversight a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "svista"@it ;
    skos:broader chora:Discrepancy ;
    skos:definition "A probable slip of the author (e.g. a misplaced accent)."@en ;
    skos:inScheme chora:UncertaintyTypeScheme ;
    skos:prefLabel "Oversight"@en .

chora:ProposedRoute a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "proposto"@it ;
    skos:definition "A route a character proposes to take, not (yet) travelled."@en ;
    skos:inScheme chora:RouteTypeScheme ;
    skos:notation "6" ;
    skos:prefLabel "Proposed"@en ;
    skos:topConceptOf chora:RouteTypeScheme .

chora:RelatedTo a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Relazione spaziale generica tra A e B, non ulteriormente specificata sul piano topologico."@it ;
    skos:altLabel "In relazione con"@it ;
    skos:inScheme chora:SpatialRelationTypeScheme ;
    skos:prefLabel "Related to"@en ;
    skos:topConceptOf chora:SpatialRelationTypeScheme .

chora:Threshold a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "A e' la soglia di B: il punto di passaggio fra un dentro e un fuori (porta, uscio, ingresso)."@it ;
    skos:altLabel "Soglia"@it ;
    skos:inScheme chora:SpatialRelationTypeScheme ;
    skos:prefLabel "Threshold"@en ;
    skos:topConceptOf chora:SpatialRelationTypeScheme .

chora:UndecidableMemory a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "attribuzione indecidibile"@it ;
    skos:definition "The text does not allow the memory to be attributed to author or character."@en ;
    skos:inScheme chora:MemoryAttributionScheme ;
    skos:prefLabel "Undecidable"@en ;
    skos:scopeNote "A reading that superimposes the two memories asserts both AuthorMemory and CharacterMemory."@en ;
    skos:topConceptOf chora:MemoryAttributionScheme .

chora:Vagueness a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "vaghezza"@it ;
    skos:definition "The extent or boundary of the place is indeterminate."@en ;
    skos:inScheme chora:UncertaintyTypeScheme ;
    skos:prefLabel "Vagueness"@en ;
    skos:topConceptOf chora:UncertaintyTypeScheme .

chora:apartment a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "Appartamento"@it ;
    skos:closeMatch <http://www.wikidata.org/entity/Q188507> ;
    skos:inScheme chora:PlaceCategoryScheme ;
    skos:prefLabel "Apartment"@en ;
    skos:topConceptOf chora:PlaceCategoryScheme .

chora:appearsInWitness a owl:ObjectProperty ;
    rdfs:comment "The witness in which a place reference occurs (D-053). Occurrences in witnesses other than the reference witness enter only as comparison corpora: they point to the same narrative place, never count in the views of the published novel, and carry no status of their own."@en ;
    rdfs:domain chora:PlaceReference ;
    rdfs:range chora:Witness ;
    skos:altLabel "compare nel testimone"@it ;
    skos:prefLabel "appears in witness"@en .

chora:bridge a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "Ponte"@it ;
    skos:closeMatch <http://www.wikidata.org/entity/Q12280> ;
    skos:inScheme chora:PlaceCategoryScheme ;
    skos:prefLabel "Bridge"@en ;
    skos:topConceptOf chora:PlaceCategoryScheme .

chora:courtyard a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "Cortile"@it ;
    skos:closeMatch <http://www.wikidata.org/entity/Q309250> ;
    skos:inScheme chora:PlaceCategoryScheme ;
    skos:prefLabel "Courtyard"@en ;
    skos:topConceptOf chora:PlaceCategoryScheme .

chora:gulf a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "Golfo"@it ;
    skos:closeMatch <http://www.wikidata.org/entity/Q1322134> ;
    skos:inScheme chora:PlaceCategoryScheme ;
    skos:prefLabel "Gulf"@en ;
    skos:topConceptOf chora:PlaceCategoryScheme .

chora:hasRealityStatus a owl:ObjectProperty ;
    dcterms:references chora:RealityStatusScheme ;
    rdfs:comment "Assigns the reality–fiction status of a narrative place, on a scale ordered from the concrete to the abstract: imported, transformed, invented, imagined (skos:notation 1–4; Reuschel, Piatti and Hurni 2013, pp. 138–139). This is an invariant property of the place as an authorial transposition of the real world into the text, NOT dependent on focalizer or interpretation."@en ;
    rdfs:domain chora:NarrativePlace ;
    rdfs:range skos:Concept ;
    skos:altLabel "ha stato di realtà"@it ;
    skos:prefLabel "has reality status"@en .

chora:hasRouteType a owl:ObjectProperty ;
    dcterms:references chora:RouteTypeScheme ;
    rdfs:comment "Type of a route, derived from the adopted route type assertion."@en ;
    rdfs:domain chora:NarrativeRoute ;
    rdfs:range skos:Concept ;
    skos:altLabel "ha tipo di percorso"@it ;
    skos:prefLabel "has route type"@en .

chora:hasSpatialGeometry a owl:ObjectProperty ;
    rdfs:range geosparql:Geometry ;
    skos:altLabel "ha geometria spaziale"@it ;
    skos:prefLabel "has spatial geometry"@en .

chora:hasUncertaintyType a owl:ObjectProperty ;
    dcterms:references chora:UncertaintyTypeScheme ;
    rdfs:comment "Type of uncertainty of an occurrence (name axis), a narrative place (identification axis) or a gazetteer entity (geometry axis)."@en ;
    rdfs:range skos:Concept ;
    skos:altLabel "ha tipo d'incertezza"@it ;
    skos:prefLabel "has uncertainty type"@en .

chora:hasVariant a owl:ObjectProperty ;
    rdfs:comment "Links an occurrence of the reference witness to the corresponding occurrence of another witness (variant reading)."@en ;
    rdfs:domain chora:PlaceReference ;
    rdfs:range chora:PlaceReference ;
    skos:altLabel "ha variante"@it ;
    skos:prefLabel "has variant"@en .

chora:hasZone a owl:ObjectProperty ;
    rdfs:comment "Links a partition to one of its zones."@en ;
    rdfs:domain chora:Partition ;
    rdfs:range chora:PartitionZone ;
    skos:altLabel "ha zona"@it ;
    skos:prefLabel "has zone"@en .

chora:house a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "Casa"@it ;
    skos:closeMatch <http://www.wikidata.org/entity/Q3947> ;
    skos:exactMatch <http://vocab.getty.edu/aat/300005433> ;
    skos:inScheme chora:PlaceCategoryScheme ;
    skos:prefLabel "House"@en ;
    skos:topConceptOf chora:PlaceCategoryScheme .

chora:identifiedWith a owl:ObjectProperty ;
    rdfs:comment "The geographic entity of the adopted identification of a narrative place; materialized by the ETL from the adopted IdentificationAssertion."@en ;
    rdfs:domain chora:NarrativePlace ;
    rdfs:range chora:GazetteerEntity ;
    skos:altLabel "identificato con"@it ;
    skos:prefLabel "identified with"@en .

chora:interpretsReference a owl:ObjectProperty ;
    rdfs:comment "Links a spatial interpretation to the specific textual place reference it interprets"@en ;
    rdfs:domain chora:SpatialInterpretation ;
    rdfs:range chora:PlaceReference ;
    skos:altLabel "interpreta il riferimento"@it ;
    skos:prefLabel "interprets reference"@en .

chora:memoryAttribution a owl:ObjectProperty ;
    dcterms:references chora:MemoryAttributionScheme ;
    rdfs:comment "Whose memory a remembered space belongs to, for an occurrence."@en ;
    rdfs:domain chora:PlaceReference ;
    rdfs:range skos:Concept ;
    skos:altLabel "attribuzione della memoria"@it ;
    skos:prefLabel "memory attribution"@en .

chora:palace a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "Palazzo"@it ;
    skos:closeMatch <http://www.wikidata.org/entity/Q16560> ;
    skos:inScheme chora:PlaceCategoryScheme ;
    skos:prefLabel "Palace"@en ;
    skos:topConceptOf chora:PlaceCategoryScheme .

chora:road a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "Strada"@it ;
    skos:inScheme chora:PlaceCategoryScheme ;
    skos:prefLabel "Road"@en ;
    skos:topConceptOf chora:PlaceCategoryScheme .

chora:small_town a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "Cittadina"@it ;
    skos:closeMatch <http://www.wikidata.org/entity/Q3957> ;
    skos:exactMatch <http://vocab.getty.edu/aat/300008375> ;
    skos:inScheme chora:PlaceCategoryScheme ;
    skos:prefLabel "Small town"@en ;
    skos:topConceptOf chora:PlaceCategoryScheme .

chora:targetsPlace a owl:ObjectProperty ;
    rdfs:comment "Links a spatial interpretation to the diegetic narrative place it activates."@en ;
    rdfs:domain chora:SpatialInterpretation ;
    rdfs:range chora:NarrativePlace ;
    skos:altLabel "ha come target il luogo"@it ;
    skos:prefLabel "targets place"@en .

chora:ward a owl:NamedIndividual,
        skos:Concept ;
    skos:altLabel "Rione"@it ;
    skos:closeMatch <http://vocab.getty.edu/aat/300000745>,
        <http://www.wikidata.org/entity/Q2983893> ;
    skos:inScheme chora:PlaceCategoryScheme ;
    skos:prefLabel "Ward"@en ;
    skos:topConceptOf chora:PlaceCategoryScheme .

chora:witnessOf a owl:ObjectProperty ;
    rdfs:comment "Links a witness to the work whose text it carries."@en ;
    rdfs:domain chora:Witness ;
    rdfs:range chora:LiteraryWork ;
    skos:altLabel "testimone di"@it ;
    skos:prefLabel "witness of"@en .

<https://w3id.org/chora/vocab/placecategory> a owl:Ontology ;
    rdfs:label "GaddAtlas Place Category Vocabulary" ;
    dc:description "Controlled vocabulary of place types used in GaddAtlas." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> .

<https://w3id.org/gaddatlas/id/act/A-0001> a hico:InterpretationAct ;
    dcterms:date "2026-10-09"^^xsd:date ;
    hico:hasInterpretationCriterion chora:TextualEvidence ;
    hico:hasInterpretationType chora:IdentificationAssertion ;
    hico:isExtractedFrom <https://w3id.org/gaddatlas/id/source/censimento_gaddatlas> ;
    prov:qualifiedAssociation <https://w3id.org/gaddatlas/id/association/A-0001-encoder-lorenzo_sabatino>,
        <https://w3id.org/gaddatlas/id/association/A-0001-readingauthor-lorenzo_sabatino> ;
    prov:startedAtTime "2026-10-09T00:00:00"^^xsd:dateTime ;
    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "Lettura del censimento: la «stazione di Castello» (QP 279) come Castel Gandolfo, lettura immediata del toponimo. Identificazione contesa (DC-04): Manzotti 2010, p. 293 legge Castel Savello; la sua lettura entra in fase 3. Non adottata finché DC-04 non è deciso."@it .

<https://w3id.org/gaddatlas/id/act/C-casal_bruciato> a hico:InterpretationAct ;
    hico:hasInterpretationCriterion chora:ReferentialEvidence ;
    hico:hasInterpretationType chora:IdentificationAssertion ;
    hico:isExtractedFrom <https://w3id.org/gaddatlas/id/source/censimento_gaddatlas> ;
    prov:qualifiedAssociation <https://w3id.org/gaddatlas/id/association/C-casal_bruciato-encoder-lorenzo_sabatino>,
        <https://w3id.org/gaddatlas/id/association/C-casal_bruciato-readingauthor-lorenzo_sabatino> ;
    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "Lettura del censimento: Casal Bruciato identificato con il quartiere omonimo del Tiburtino (41,9070 N 12,5506 E)."@it .

<https://w3id.org/gaddatlas/id/act/C-edicola_due_santi> a hico:InterpretationAct ;
    hico:hasInterpretationCriterion chora:CriticalReading ;
    hico:hasInterpretationType chora:StatusAssertion ;
    hico:isExtractedFrom <https://w3id.org/gaddatlas/id/source/censimento_gaddatlas> ;
    prov:qualifiedAssociation <https://w3id.org/gaddatlas/id/association/C-edicola_due_santi-encoder-lorenzo_sabatino>,
        <https://w3id.org/gaddatlas/id/association/C-edicola_due_santi-readingauthor-lorenzo_sabatino> ;
    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "Lettura del censimento: «Edicola immaginata», parte dell'orto/vigna dei Due Santi, senza ancoraggio. Nel censimento l'etichetta era «Imagined», che prima della correzione dello schema (D-030) designava il luogo fittizio in una geografia nota, oggi Invented."@it .

<https://w3id.org/gaddatlas/id/act/C-palazzo_simonetti> a hico:InterpretationAct ;
    hico:hasInterpretationCriterion chora:ReferentialEvidence ;
    hico:hasInterpretationType chora:StatusAssertion ;
    hico:isExtractedFrom <https://w3id.org/gaddatlas/id/source/censimento_gaddatlas> ;
    prov:qualifiedAssociation <https://w3id.org/gaddatlas/id/association/C-palazzo_simonetti-encoder-lorenzo_sabatino>,
        <https://w3id.org/gaddatlas/id/association/C-palazzo_simonetti-readingauthor-lorenzo_sabatino> ;
    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "Lettura del censimento: palazzo reale, ancorato a via Lanza dove lo pone QP 177."@it .

<https://w3id.org/gaddatlas/id/act/I-casal_bruciato> a hico:InterpretationAct ;
    dcterms:date "2026-10-09"^^xsd:date ;
    hico:hasInterpretationCriterion chora:ReferentialEvidence ;
    hico:hasInterpretationType chora:IdentificationAssertion ;
    hico:isExtractedFrom <https://w3id.org/gaddatlas/id/source/manzotti_2010> ;
    prov:qualifiedAssociation <https://w3id.org/gaddatlas/id/association/I-casal_bruciato-encoder-lorenzo_sabatino>,
        <https://w3id.org/gaddatlas/id/association/I-casal_bruciato-readingauthor-lorenzo_sabatino> ;
    prov:startedAtTime "2026-10-09T00:00:00"^^xsd:dateTime ;
    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "Casal Bruciato è il casale dell'Agro romano a sud di Roma, «Casal(e) Bruciato / Abbruciato / Abbrusciato» (Nibby, Dintorni di Roma, p. 569), fra le ferrovie Roma–Napoli e Roma–Velletri; posizione adottata TCI (D-037)."@it ;
    chora:sourcePage "268–269; Tavv. VI–VII, pp. 300–301"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/P-0001> a hico:InterpretationAct ;
    dcterms:date "2026-10-09"^^xsd:date ;
    hico:hasInterpretationCriterion chora:CriticalReading ;
    hico:hasInterpretationType chora:PartitionAssertion ;
    hico:isExtractedFrom <https://w3id.org/gaddatlas/id/source/sabatino_cap4> ;
    prov:qualifiedAssociation <https://w3id.org/gaddatlas/id/association/P-0001-encoder-lorenzo_sabatino>,
        <https://w3id.org/gaddatlas/id/association/P-0001-readingauthor-lorenzo_sabatino> ;
    prov:startedAtTime "2026-10-09T00:00:00"^^xsd:dateTime ;
    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "Partizione Roma città / campagna romana, lettura adottata dal progetto. Criterio: distanza dell'ancora primaria del luogo dal Campidoglio; città fino a 10 km (nei dati il primo luogo di campagna, Castel di Leva, è a 12,9 km; l'ultimo urbano, l'Acqua Marcia, a 8,4), campagna fra 10 e 30 km. Non si assegnano d'ufficio entità lineari o areali che attraversano la soglia, luoghi Imagined, luoghi senza ancora, il litorale e la fascia fra 30 e 60 km: sono i casi di confine (REVIEW_2)."@it ;
    chora:sourcePage "§ 4.1, § 4.6 (R20)"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/R-0001> a hico:InterpretationAct ;
    dcterms:date "2026-10-09"^^xsd:date ;
    hico:hasInterpretationCriterion chora:TextualEvidence ;
    hico:hasInterpretationType chora:RouteTypeAssertion ;
    hico:isExtractedFrom <https://w3id.org/gaddatlas/id/witness/qp> ;
    prov:qualifiedAssociation <https://w3id.org/gaddatlas/id/association/R-0001-encoder-lorenzo_sabatino>,
        <https://w3id.org/gaddatlas/id/association/R-0001-readingauthor-lorenzo_sabatino> ;
    prov:startedAtTime "2026-10-09T00:00:00"^^xsd:dateTime ;
    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "«Discesero ai Torraccio […] Svoltarono sull'Appia a li Due Santi […] Valicò invece il binario»: Ingravallo, Di Pietrantonio, l'autista e Runzato percorrono il tragitto in auto."@it ;
    chora:sourcePage "297"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/R-0002> a hico:InterpretationAct ;
    dcterms:date "2026-10-09"^^xsd:date ;
    hico:hasInterpretationCriterion chora:TextualEvidence ;
    hico:hasInterpretationType chora:RouteTypeAssertion ;
    hico:isExtractedFrom <https://w3id.org/gaddatlas/id/witness/qp> ;
    prov:qualifiedAssociation <https://w3id.org/gaddatlas/id/association/R-0002-encoder-lorenzo_sabatino>,
        <https://w3id.org/gaddatlas/id/association/R-0002-readingauthor-lorenzo_sabatino> ;
    prov:startedAtTime "2026-10-09T00:00:00"^^xsd:dateTime ;
    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "La motocicletta di Santarella «si preannunciava di lontano, dal Torraccio, […] o dal Divino Amore»: le provenienze si ricavano dal rumore, «altre volte» da un luogo o dall'altro."@it ;
    chora:sourcePage "169"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/R-0003> a hico:InterpretationAct ;
    dcterms:date "2026-10-09"^^xsd:date ;
    hico:hasInterpretationCriterion chora:TextualEvidence ;
    hico:hasInterpretationType chora:RouteTypeAssertion ;
    hico:isExtractedFrom <https://w3id.org/gaddatlas/id/witness/qp> ;
    prov:qualifiedAssociation <https://w3id.org/gaddatlas/id/association/R-0003-encoder-lorenzo_sabatino>,
        <https://w3id.org/gaddatlas/id/association/R-0003-readingauthor-lorenzo_sabatino> ;
    prov:startedAtTime "2026-10-09T00:00:00"^^xsd:dateTime ;
    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "Pestalozzi e Cocullo scendono dalla caserma di Marino alla porta del borgo, prendono l'Appia, passano la Fontana e si fermano ai Due Santi."@it ;
    chora:sourcePage "208–215"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/R-0004> a hico:InterpretationAct ;
    dcterms:date "2026-10-09"^^xsd:date ;
    hico:hasInterpretationCriterion chora:TextualEvidence ;
    hico:hasInterpretationType chora:RouteTypeAssertion ;
    hico:isExtractedFrom <https://w3id.org/gaddatlas/id/witness/qp> ;
