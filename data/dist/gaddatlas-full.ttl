    chora:attestedForm "Pensione Bergesse"@it ;
    chora:excerpt "« All’ufficio stranieri, Pompè, allo schedario. Pensione Bergesse. E bbuona pesca. »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 189"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00468> a chora:PlaceReference ;
    chora:appearsInWitness <https://w3id.org/gaddatlas/id/witness/qp> ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio> ;
    chora:excerpt "« E ddomani mattina, Pompè, ve n’iate a spasso a via Veneto. Vuie v’avite a ’ncuntrà l’inglesa pe cumbinazione, c’intendiamo? »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 189"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00469> a chora:PlaceReference ;
    chora:appearsInWitness <https://w3id.org/gaddatlas/id/witness/qp> ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio> ;
    chora:excerpt "« Chelle guaglione sbarcano a l’Immacolatella a ciento cinquanta pe’ vvota! A ’o molo Beverello! Da ’o Conte Verde! »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_VII> ;
    chora:sourceReference "A 190"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00470> a chora:PlaceReference ;
