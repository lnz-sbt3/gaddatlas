    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio> ;
    chora:excerpt "« E la Roma-Napoli? » « Là, » e si voltò: « so' tre chilometri emmezzo puro quattro: nun c'è che d'annà avanti co la machina. »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_X> ;
    chora:sourceReference "A 298"^^xsd:string .

<https://w3id.org/gaddatlas/id/reference/ref_00720> a chora:PlaceReference ;
    chora:appearsInWitness <https://w3id.org/gaddatlas/id/witness/qp> ;
    chora:appearsInWork <https://w3id.org/gaddatlas/id/work/quer_pasticciaccio> ;
    chora:excerpt "« Fate passare, in ogni modo. Andiamo. Su. Devo far perquisire la casa. »"@it ;
    chora:mentionedInChapter <https://w3id.org/gaddatlas/id/chapter/capitolo_X> ;
    chora:sourceReference "A 302"^^xsd:string .

