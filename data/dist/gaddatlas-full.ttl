    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/agent/manzotti> ;
    chora:rationale "«d'in vetta al crinale degli Ernici o dei Simbruini» (QP 215): identificazione per disgiunzione, non risolta dal testo (WO T-16; Cap. 4, § 4.4)."@it ;
    chora:sourcePage "290"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/U-0007> a hico:InterpretationAct ;
    dcterms:date "2010"^^xsd:gYear ;
    hico:hasInterpretationCriterion chora:CriticalReading ;
    hico:hasInterpretationType chora:UncertaintyAssertion ;
