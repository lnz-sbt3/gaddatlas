    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "Il commendator Angeloni e i suoi pari «sogliono deambulare» da Sant'Agostino a Santa Maria in Aquiro."@it ;
    chora:sourcePage "40"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/R-0008> a hico:InterpretationAct ;
