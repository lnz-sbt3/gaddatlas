<https://w3id.org/gaddatlas/id/act/S-robine_vecchie> a hico:InterpretationAct ;
    dcterms:date "2026-10-09"^^xsd:date ;
    hico:hasInterpretationCriterion chora:CriticalReading ;
    hico:hasInterpretationType chora:StatusAssertion ;
    hico:isExtractedFrom <https://w3id.org/gaddatlas/id/source/terzoli_2015> ;
    prov:qualifiedAssociation <https://w3id.org/gaddatlas/id/association/S-robine_vecchie-encoder-lorenzo_sabatino>,
        <https://w3id.org/gaddatlas/id/association/S-robine_vecchie-readingauthor-lorenzo_sabatino> ;
