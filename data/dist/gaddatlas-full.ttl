    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "La motocicletta di Santarella «infilava […] la mala curva d'aa stazione d'aa Cecchina», poi si fermava a Santa Palomba e a Campoleone, «il caso richiedendo»."@it ;
    chora:sourcePage "173"^^xsd:string .

<https://w3id.org/gaddatlas/id/act/R-0009> a hico:InterpretationAct ;
