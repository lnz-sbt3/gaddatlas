<https://w3id.org/gaddatlas/id/act/S-castel_porcano> a hico:InterpretationAct ;
    dcterms:date "2026-10-09"^^xsd:date ;
    hico:hasInterpretationCriterion chora:CriticalReading ;
    hico:hasInterpretationType chora:StatusAssertion ;
    hico:isExtractedFrom <https://w3id.org/gaddatlas/id/source/manzotti_2010> ;
    prov:qualifiedAssociation <https://w3id.org/gaddatlas/id/association/S-castel_porcano-encoder-lorenzo_sabatino>,
        <https://w3id.org/gaddatlas/id/association/S-castel_porcano-readingauthor-lorenzo_sabatino> ;
    prov:startedAtTime "2026-10-09T00:00:00"^^xsd:dateTime ;
    prov:wasAssociatedWith <https://w3id.org/gaddatlas/id/annotator/lorenzo_sabatino> ;
    chora:rationale "Cap. 4, § 4.3 (r. 85): la denominazione è una «deformazione paraetimologica d'un toponimo reale» (Castelporziano, «il che penderebbe verso il luogo trasformato»), mentre la festa notturna «appartiene a uno spazio onirico e destrutturato, privo di collocazione metrica e dunque ascrivibile alla categoria dell'immaginato». Perimetro d'identità da dichiarare (H3, DC-09, DC-11)."@it ;
    chora:sourcePage "273, 276"^^xsd:string .

