# =============================================================================
# GaddAtlas v4.1 — Integrity queries
# Complementari a SHACL: SHACL verifica la forma dei dati, queste verificano
# invarianti di modello e completezza. Tutte devono restituire ZERO righe,
# tranne IQ9 e IQ11 che sono informative.
# =============================================================================


# ==== IQ1 — Interpretazioni senza bersaglio (atteso: 0) ====
PREFIX ga: <https://w3id.org/chora#>
SELECT ?interp WHERE {
  ?interp a ga:SpatialInterpretation .
  FILTER NOT EXISTS { ?interp ga:targetsPlace ?p }
  FILTER NOT EXISTS { ?interp ga:targetsRoute ?r }
}


# ==== IQ2 — Interpretazioni con doppio bersaglio (atteso: 0) ====
PREFIX ga: <https://w3id.org/chora#>
SELECT ?interp WHERE {
  ?interp ga:targetsPlace ?p ;
          ga:targetsRoute ?r .
}


# ==== IQ3 — IRI referenziate ma mai tipizzate (atteso: 0) ====
# I "nodi fantasma": bersagli di una property che non esistono come entita'.
# E' il fallimento silenzioso classico di un ETL con ID disallineati.
PREFIX ga: <https://w3id.org/chora#>
SELECT DISTINCT ?nodo WHERE {
  { ?x ga:targetsPlace ?nodo }        UNION
  { ?x ga:anchorsToEntity ?nodo }     UNION
  { ?x ga:mentionedInChapter ?nodo }  UNION
  { ?x ga:hasFocalizer ?nodo }        UNION
  { ?x ga:targetsRoute ?nodo }        UNION
  { ?x ga:isPartOf ?nodo }            UNION
  { ?x ga:appearsInWork ?nodo }       UNION
  { ?x ga:appearsInWitness ?nodo }
  FILTER NOT EXISTS { ?nodo a ?t }
}


# ==== IQ4 — RealityStatus multiplo sullo stesso luogo (atteso: 0) ====
# Invariante empirica del modello: RealityStatus appartiene al luogo, non
# all'occorrenza.
PREFIX ga: <https://w3id.org/chora#>
SELECT ?place (COUNT(?s) AS ?n) WHERE {
  ?place a ga:NarrativePlace ;
         ga:hasRealityStatus ?s .
}
GROUP BY ?place
HAVING (COUNT(?s) > 1)


# ==== IQ5 — Nodi di percorso senza routeOrder (atteso: 0) ====
PREFIX ga: <https://w3id.org/chora#>
SELECT ?interp WHERE {
  ?interp ga:isNodeOfRoute ?route .
  FILTER NOT EXISTS { ?interp ga:routeOrder ?o }
}


# ==== IQ6 — PlaceReference senza excerpt o senza opera e testimone (atteso: 0) ====
# L'estratto e' obbligatorio per le occorrenze del testimone di riferimento;
# per quelle degli altri testimoni (corpora di confronto, D-053) e'
# facoltativo, e non arriva mai all'interfaccia (D-055, D-066).
PREFIX ga: <https://w3id.org/chora#>
SELECT ?ref WHERE {
  ?ref a ga:PlaceReference .
  { FILTER NOT EXISTS { ?ref ga:excerpt ?e }
    ?ref ga:appearsInWitness ?w . ?opera ga:referenceWitness ?w }
  UNION
  { FILTER NOT EXISTS { ?ref ga:appearsInWork ?o } }
  UNION
  { FILTER NOT EXISTS { ?ref ga:appearsInWitness ?t } }
}


# ==== IQ7 — Tragitti orfani (atteso: 0) ====
# NarrativeRoute che nessuna interpretazione attiva.
PREFIX ga: <https://w3id.org/chora#>
SELECT ?route WHERE {
  ?route a ga:NarrativeRoute .
  FILTER NOT EXISTS { ?i ga:targetsRoute ?route }
}


# ==== IQ8 — Entita' di gazetteer senza coordinate (atteso: 0) ====
PREFIX ga: <https://w3id.org/chora#>
PREFIX geo: <http://www.w3.org/2003/01/geo/wgs84_pos#>
SELECT ?gaz WHERE {
  ?gaz a ga:GazetteerEntity .
  FILTER NOT EXISTS { ?gaz geo:lat ?lat }
}


# ==== IQ9 — Luoghi narrativi mai interpretati (INFORMATIVA) ====
# Non e' un errore: sono luoghi censiti in NarrativePlaces ma che nessuna
# SpatialInterpretation bersaglia. Vanno letti come residuo di censimento
# da sanare o da giustificare, non come violazione.
PREFIX ga: <https://w3id.org/chora#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?place ?toponimo WHERE {
  ?place a ga:NarrativePlace ;
         rdfs:label ?toponimo .
  FILTER NOT EXISTS { ?i ga:targetsPlace ?place }
}
ORDER BY ?toponimo


# ==== IQ10 — Cicli di meronimia diretti (atteso: 0) ====
PREFIX ga: <https://w3id.org/chora#>
SELECT ?a ?b WHERE {
  ?a ga:isPartOf ?b .
  ?b ga:isPartOf ?a .
}


# ==== IQ11 — Riferimenti con piu' luoghi narrativi (INFORMATIVA) ====
# Un riferimento le cui interpretazioni bersagliano luoghi diversi. Puo' essere
# un errore (interpretazione agganciata al riferimento sbagliato) o una
# referenza plurale voluta («da Faiti o da Cengio», R04, T-47): va letta caso
# per caso. Il controllo bloccante sta in tools/audit_alignment.py, sulle
# sorgenti: nel grafo la PlaceReference non porta il proprio luogo (D-026).
PREFIX ga: <https://w3id.org/chora#>
SELECT ?ref (COUNT(DISTINCT ?place) AS ?luoghi) WHERE {
  ?interp ga:interpretsReference ?ref ;
          ga:targetsPlace ?place .
}
GROUP BY ?ref
HAVING (COUNT(DISTINCT ?place) > 1)
ORDER BY ?ref


# ==== IQ12 — Piu' letture adottate per lo stesso soggetto e tipo (atteso: 0) ====
# Nessuna lettura e' il default del modello, ma il progetto ne adotta al piu'
# una per soggetto e tipo di asserzione (D-042): e' quella che l'interfaccia
# mostra. Due letture adottate sullo stesso punto sono un errore.
PREFIX ga: <https://w3id.org/chora#>
PREFIX hico: <http://purl.org/emmedi/hico/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?soggetto ?tipo (COUNT(?a) AS ?adottate) WHERE {
  ?a a ga:Assertion ;
     ga:aboutSubject ?soggetto ;
     prov:wasGeneratedBy/hico:hasInterpretationType ?tipo ;
     ga:adoptedByProject true .
}
GROUP BY ?soggetto ?tipo
HAVING (COUNT(?a) > 1)


# ==== IQ13 — Statuto del luogo senza esattamente una lettura adottata, o diverso da essa (atteso: 0) ====
# Su tutti i luoghi (D-068): ogni hasRealityStatus deriva da esattamente una
# lettura di statuto adottata (esplicita o generata dall'ETL), e il valore coincide.
PREFIX ga: <https://w3id.org/chora#>
PREFIX hico: <http://purl.org/emmedi/hico/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?luogo ?statuto ?n ?adottato WHERE {
  {
    SELECT ?luogo ?statuto (COUNT(DISTINCT ?a) AS ?n) (SAMPLE(?v) AS ?adottato) WHERE {
      ?luogo a ga:NarrativePlace ; ga:hasRealityStatus ?statuto .
      OPTIONAL {
        ?a ga:aboutSubject ?luogo ; ga:adoptedByProject true ; ga:assertsValue ?v ;
           prov:wasGeneratedBy/hico:hasInterpretationType ga:StatusAssertion .
      }
    } GROUP BY ?luogo ?statuto
  }
  FILTER (?n != 1 || ?adottato != ?statuto)
}


# ==== IQ14 — Luoghi senza ancoraggio e senza stato di localizzazione (atteso: 0) ====
# Un luogo narrativo senza ancoraggio (proprio, ereditato via isPartOf o da
# un'identificazione adottata) deve dichiarare perche': analisi non condotta,
# sospensione motivata, coordinata non applicabile (D-048). Il dato mancante
# non e' un'astensione.
PREFIX ga: <https://w3id.org/chora#>
PREFIX hico: <http://purl.org/emmedi/hico/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?luogo WHERE {
  ?luogo a ga:NarrativePlace .
  FILTER NOT EXISTS { ?luogo ga:isPartOf* ?q . ?si ga:targetsPlace ?q ; ga:anchorsToEntity ?e }
  FILTER NOT EXISTS { ?luogo ga:isPartOf* ?q2 . ?a ga:aboutSubject ?q2 ;
                      prov:wasGeneratedBy/hico:hasInterpretationType ga:IdentificationAssertion ; ga:adoptedByProject true }
  FILTER NOT EXISTS { ?luogo ga:localizationStatus ?s }
}
ORDER BY ?luogo

# ==== IQ15 — Luogo in piu' zone della stessa partizione (atteso: 0) ====
# Dentro un'ipotesi di partizione un luogo sta al piu' in una zona (D-050).
PREFIX ga: <https://w3id.org/chora#>
SELECT ?luogo ?partizione WHERE {
  ?partizione ga:hasZone ?z1, ?z2 .
  ?luogo ga:inPartitionZone ?z1, ?z2 .
  FILTER (STR(?z1) < STR(?z2))
}
ORDER BY ?luogo

# ==== IQ16 — Revisione su un altro soggetto o di un altro tipo, o adottata due volte (atteso: 0) ====
# Una revisione (prov:wasRevisionOf) riguarda lo stesso soggetto e lo stesso
# tipo della lettura che rivede, e la lettura rivista non e' piu' adottata (D-051).
PREFIX ga: <https://w3id.org/chora#>
PREFIX hico: <http://purl.org/emmedi/hico/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?nuova ?vecchia WHERE {
  ?nuova prov:wasRevisionOf ?vecchia .
  ?nuova ga:aboutSubject ?s1 ; prov:wasGeneratedBy/hico:hasInterpretationType ?t1 .
  OPTIONAL { ?vecchia ga:aboutSubject ?s2 ; prov:wasGeneratedBy/hico:hasInterpretationType ?t2 }
  OPTIONAL { ?vecchia ga:adoptedByProject ?adottata }
  FILTER (!BOUND(?s2) || ?s1 != ?s2 || ?t1 != ?t2 || COALESCE(?adottata, false))
}
ORDER BY ?nuova

# ==== IQ17 — Occorrenza di un altro testimone senza variante, o interpretata (atteso: 0) ====
# Un'occorrenza fuori dal testimone di riferimento entra solo come confronto
# (D-054): sta in un'asserzione di variante che ha per soggetto il luogo, e non
# ha interpretazioni proprie, perche' statuto e ruolo sono del luogo, non del
# testimone.
PREFIX ga: <https://w3id.org/chora#>
PREFIX hico: <http://purl.org/emmedi/hico/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?occorrenza ?problema WHERE {
  ?occorrenza ga:appearsInWitness ?w .
  FILTER NOT EXISTS { ?opera ga:referenceWitness ?w }
  {
    FILTER NOT EXISTS { ?a prov:wasGeneratedBy/hico:hasInterpretationType ga:VariantAssertion ; ga:assertsValue ?occorrenza }
    BIND("senza variante" AS ?problema)
  } UNION {
    ?si ga:interpretsReference ?occorrenza .
    BIND("interpretata" AS ?problema)
  }
}
ORDER BY ?occorrenza


# ==== IQ19 — Coordinata dell'entita' diversa dalla posizione adottata (atteso: 0) ====
# La coordinata della GazetteerEntity (geo1:lat, geo1:long, dal foglio) deve
# coincidere con la geometria della LocationAssertion adottata (D-069).
PREFIX ga: <https://w3id.org/chora#>
PREFIX hico: <http://purl.org/emmedi/hico/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX geo1: <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?entita ?lat ?long ?wkt WHERE {
  ?a ga:aboutSubject ?entita ; ga:adoptedByProject true ; ga:assertsValue ?g ;
     prov:wasGeneratedBy/hico:hasInterpretationType ga:LocationAssertion .
  ?g geo:asWKT ?wkt .
  ?entita geo1:lat ?lat ; geo1:long ?long .
  BIND (STRBEFORE(STRAFTER(STR(?wkt), "POINT("), ")") AS ?xy)
  BIND (xsd:decimal(STRBEFORE(?xy, " ")) AS ?x)
  BIND (xsd:decimal(STRAFTER(?xy, " ")) AS ?y)
  FILTER (ABS(?x - xsd:decimal(?long)) > 0.000001 || ABS(?y - xsd:decimal(?lat)) > 0.000001)
}
