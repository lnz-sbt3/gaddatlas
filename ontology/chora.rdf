    <!-- http://www.opengis.net/ont/geosparql#Geometry -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Geometry">
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql"/>
        <skos:altLabel xml:lang="it">Geometria</skos:altLabel>
        <skos:definition xml:lang="en">A coherent set of direct positions in space</skos:definition>
        <skos:prefLabel xml:lang="en">Geometry</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->

    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#ConceptScheme -->

    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    


    <!-- http://www.w3.org/ns/prov#Agent -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Entity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
    </owl:Class>
    


    <!-- https://w3id.org/chora#Chapter -->

    <owl:Class rdf:about="https://w3id.org/chora#Chapter"/>
    


    <!-- https://w3id.org/chora#Character -->

    <owl:Class rdf:about="https://w3id.org/chora#Character">
        <rdfs:subClassOf rdf:resource="https://w3id.org/chora#FocalizingAgent"/>
        <skos:altLabel>Personaggio</skos:altLabel>
        <skos:prefLabel xml:lang="en">Character</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/chora#FocalizingAgent -->

    <owl:Class rdf:about="https://w3id.org/chora#FocalizingAgent">
        <rdfs:comment xml:lang="it">Entità attraverso cui lo spazio è percepito/descritto</rdfs:comment>
        <skos:altLabel xml:lang="it">Agente Focalizzatore</skos:altLabel>
        <skos:prefLabel xml:lang="en">Focalizing Agent</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/chora#GazetteerEntity -->

    <owl:Class rdf:about="https://w3id.org/chora#GazetteerEntity">
        <rdfs:comment xml:lang="en">GazetteerEntity does not belong to the world of the text: it models the external topographic counterpart. The relation to a NarrativePlace is not assumed as identity but as a typed anchoring, asserted by SpatialInterpretation.</rdfs:comment>
        <rdfs:comment xml:lang="it">GazetteerEntity non appartiene al mondo del testo: modella la controparte topografica esterna. La relazione con NarrativePlace non è assunta come identità, ma come ancoraggio tipizzato, espresso da SpatialInterpretation.</rdfs:comment>
        <skos:definition xml:lang="en">An extra-textual georeferenceable place described as an authority/gazetteer entity, typically endowed with stable geometry (coordinates or GeoJSON) and persistent identifiers; it provides the external topographic referent to which narrative places may be anchored.</skos:definition>
        <skos:definition xml:lang="it">Luogo extra-testuale georeferenziabile, descritto come entità di authority/gazetteer e tipicamente dotato di geometria stabile (coordinate o GeoJSON) e identificatori persistenti; costituisce il referente topografico esterno a cui possono essere ancorati i luoghi narrativi.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/chora#LiteraryWork -->

    <owl:Class rdf:about="https://w3id.org/chora#LiteraryWork"/>
    


    <!-- https://w3id.org/chora#NarrativePlace -->

    <owl:Class rdf:about="https://w3id.org/chora#NarrativePlace">
        <owl:disjointWith rdf:resource="https://w3id.org/chora#PlaceReference"/>
        <rdfs:comment xml:lang="it">NarrativePlace include sia luoghi importati o riconducibili a toponimi reali, sia luoghi inventati ma diegeticamente localizzati (es. edifici finzionali collocati in una via reale). L’eventuale corrispondenza topografica è dichiarata tramite ancoraggio a GazetteerEntity e qualificata da status/relazioni.</rdfs:comment>
        <rdfs:comment xml:lang="en">NarrativePlace includes both imported places traceable to real toponyms and invented places that are diegetically localized (e.g., fictional buildings located on a real street). Any topographic correspondence is declared via anchoring to a GazetteerEntity and qualified by status/relations.</rdfs:comment>
        <rdfs:comment xml:lang="it">NarrativePlace modella l’unità spaziale “nel romanzo”, distinta dal referente topografico esterno (GazetteerEntity). La relazione fra i due piani è espressa tramite ancoraggi e relazioni tipizzate a livello di SpatialInterpretation.</rdfs:comment>
        <rdfs:comment xml:lang="en">NarrativePlace models the spatial unit “in the novel”, distinct from the external topographic referent (GazetteerEntity). The relation between the two planes is expressed through anchoring and typed relations at the level of SpatialInterpretation.</rdfs:comment>
        <skos:definition xml:lang="en">A spatial entity belonging to the world of the text: a place constructed and recognizable within the diegesis, independently of any correspondence with an extra-textual georeferenceable place.</skos:definition>
        <skos:definition xml:lang="it">Entità spaziale appartenente al mondo del testo: un luogo costruito e riconoscibile nella diegesi, indipendentemente dalla sua eventuale corrispondenza con un luogo extra-testuale georeferenziabile.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/chora#NarrativeRoute -->

    <owl:Class rdf:about="https://w3id.org/chora#NarrativeRoute">
        <rdfs:comment xml:lang="en">A route (tragitto): an ordered aggregate of narrative places traversed by a focalizer. Distinct from NarrativePlace — a route is not a place but a second-order sequence of places. Carries its own interpretations (per focalizer) via SpatialInterpretation, and aggregates ordered nodes via isNodeOfRoute / routeOrder.</rdfs:comment>
        <skos:altLabel xml:lang="it">Tragitto</skos:altLabel>
        <skos:definition xml:lang="en">A second-order spatial entity representing an ordered path connecting multiple narrative places, as perceived by one or more focalizers.</skos:definition>
        <skos:definition xml:lang="it">Entità spaziale di secondo livello che rappresenta un percorso ordinato che connette più luoghi narrativi, così come percepito da uno o più focalizzatori.</skos:definition>
        <skos:prefLabel xml:lang="en">Narrative Route</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/chora#Narrator -->

    <owl:Class rdf:about="https://w3id.org/chora#Narrator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/chora#FocalizingAgent"/>
        <skos:altLabel xml:lang="it">Narratore</skos:altLabel>
        <skos:prefLabel xml:lang="en">Narrator</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/chora#PlaceReference -->

    <owl:Class rdf:about="https://w3id.org/chora#PlaceReference">
        <rdfs:comment xml:lang="en">A PlaceReference does not “resolve” a referent nor determine the place type: disambiguation, classification, and any topographic anchoring are asserted at the level of SpatialInterpretation.</rdfs:comment>
        <rdfs:comment xml:lang="it">PlaceReference non “risolve” il referente né determina il tipo di luogo: la disambiguazione, la classificazione e l’eventuale ancoraggio topografico sono esplicitati a livello di SpatialInterpretation.</rdfs:comment>
        <skos:definition xml:lang="en">A textual occurrence in which the text mentions or evokes a spatial element; it is the basic evidential unit and includes bibliographic and contextual information (e.g., source, page, passage, quotation).</skos:definition>
        <skos:definition xml:lang="it">Occorrenza testuale in cui il testo menziona o richiama un elemento spaziale; costituisce l’unità attestativa di base e include informazioni bibliografiche e contestuali (es. fonte, pagina, segmento, citazione).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/chora#SpatialInterpretation -->

    <owl:Class rdf:about="https://w3id.org/chora#SpatialInterpretation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="it">SpatialInterpretation esplicita la natura dichiarativa e tracciabile dell’annotazione: diverse interpretazioni possono coesistere per lo stesso PlaceReference, con diverse assunzioni e livelli di confidenza; per questo il modello privilegia proprietà “targets/assigns/anchors” a questo livello.</rdfs:comment>
        <rdfs:comment xml:lang="en">SpatialInterpretation makes the declarative and traceable nature of annotation explicit: multiple interpretations may coexist for the same PlaceReference, with different assumptions and confidence levels; therefore the model privileges “targets/assigns/anchors” properties at this level.</rdfs:comment>
        <skos:definition xml:lang="en">An interpretive act that operates on a PlaceReference and asserts (i) the diegetic place it activates (target), (ii) semantic qualifications via controlled vocabularies (e.g., narrative role, reality status, degree of spatial determination, spatial relation type), and (iii) any anchoring to an external topographic referent (gazetteer).</skos:definition>
        <skos:definition xml:lang="it">Atto interpretativo che prende in carico un PlaceReference e asserisce (i) quale luogo diegetico esso attiva (target), (ii) le qualificazioni semantiche tramite vocabolari controllati (es. ruolo narrativo, status di realtà, grado di determinazione spaziale, tipo di relazione spaziale), e (iii) l’eventuale ancoraggio a un referente topografico esterno (gazetteer).</skos:definition>
    </owl:Class>
    


