        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:altLabel xml:lang="it">Ambientazione</skos:altLabel>
        <skos:definition xml:lang="en">Place where the action occurs, with characters physically present</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/chora#NarrativeRoleScheme"/>
        <skos:prefLabel xml:lang="en">Setting</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/chora#NarrativeRoleScheme"/>
    </owl:NamedIndividual>
    


