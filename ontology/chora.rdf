        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <dcterms:description>A contiene spazialmente B. Relazione inversa di Inside.</dcterms:description>
        <rdfs:comment xml:lang="it">Inverso di Inside, basato su GeoSPARQL sfContains</rdfs:comment>
        <skos:altLabel xml:lang="it">Contiene</skos:altLabel>
        <skos:inScheme rdf:resource="https://w3id.org/chora#SpatialRelationTypeScheme"/>
