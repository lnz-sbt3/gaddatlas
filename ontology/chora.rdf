        <skos:topConceptOf rdf:resource="https://w3id.org/chora#SpatialRelationTypeScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/chora#Imagined -->

    <owl:NamedIndividual rdf:about="https://w3id.org/chora#Imagined">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:differentFrom rdf:resource="https://w3id.org/chora#Imported"/>
        <owl:differentFrom rdf:resource="https://w3id.org/chora#Invented"/>
