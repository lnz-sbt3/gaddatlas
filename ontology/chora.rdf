>
  <rdf:Description rdf:about="http://purl.org/dc/terms/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/references">
    <rdfs:comment xml:lang="en">Links a property to the SKOS ConceptScheme from which its values are drawn. The rdfs:range of these properties is the generic skos:Concept; this annotation states which controlled vocabulary is actually admissible, and drives the cross-links in the generated documentation.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ror.org/01111rn36">
    <rdf:type rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <schema:name>Università di Bologna</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#NarrativeRoute">
    <skos:prefLabel xml:lang="en">Narrative Route</skos:prefLabel>
    <skos:altLabel xml:lang="it">Tragitto</skos:altLabel>
    <rdfs:comment xml:lang="en">A route (tragitto): an ordered aggregate of narrative places traversed by a focalizer. Distinct from NarrativePlace — a route is not a place but a second-order sequence of places. Carries its own interpretations (per focalizer) via SpatialInterpretation, and aggregates ordered nodes via isNodeOfRoute / routeOrder.</rdfs:comment>
    <skos:definition xml:lang="en">A second-order spatial entity representing an ordered path connecting multiple narrative places, as perceived by one or more focalizers.</skos:definition>
    <skos:definition xml:lang="it">Entità spaziale di secondo livello che rappresenta un percorso ordinato che connette più luoghi narrativi, così come percepito da uno o più focalizzatori.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.wikidata.org/entity/Q4989906">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#Overlaps">
    <dcterms:description xml:lang="it">A e B condividono una porzione di spazio senza che l'uno contenga l'altro. Sovrapposizione parziale.</dcterms:description>
    <skos:inScheme rdf:resource="https://w3id.org/chora#SpatialRelationTypeScheme"/>
    <rdfs:comment xml:lang="it">Basato su RCC-8 PO (Partial Overlap) e GeoSPARQL sfOverlaps</rdfs:comment>
    <skos:topConceptOf rdf:resource="https://w3id.org/chora#SpatialRelationTypeScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="it">Sovrapposto</skos:altLabel>
    <skos:prefLabel xml:lang="en">Overlaps</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#targetsPlace">
    <skos:prefLabel xml:lang="en">targets place</skos:prefLabel>
    <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
    <skos:altLabel xml:lang="it">ha come target il luogo</skos:altLabel>
    <rdfs:comment xml:lang="en">Links a spatial interpretation to the diegetic narrative place it activates.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/chora#NarrativePlace"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#isPartOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <skos:prefLabel xml:lang="en">is part of</skos:prefLabel>
    <rdfs:domain rdf:resource="https://w3id.org/chora#NarrativePlace"/>
    <rdfs:comment xml:lang="en">Meronymic relation between narrative places: the subject place is a structural component of the object place (e.g. a staircase of a building). Invariant with respect to focalizer. A place with isPartOf inherits its geographic anchoring from the parent and should NOT carry its own anchorsToEntity.</rdfs:comment>
    <skos:altLabel xml:lang="it">è parte di</skos:altLabel>
    <rdfs:range rdf:resource="https://w3id.org/chora#NarrativePlace"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#Below">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/chora#SpatialRelationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Below</skos:prefLabel>
    <skos:altLabel xml:lang="it">Sotto</skos:altLabel>
    <rdfs:comment xml:lang="it">Inverso di Above, basato su Verticality e preposizioni cognitive</rdfs:comment>
    <skos:topConceptOf rdf:resource="https://w3id.org/chora#SpatialRelationTypeScheme"/>
    <dcterms:description xml:lang="it">A è verticalmente sotto B lungo l'asse gravitazionale. Relazione inversa di Above.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#Relative">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/chora#SpatialDeterminationScheme"/>
    <skos:altLabel xml:lang="it">Relativa</skos:altLabel>
    <skos:prefLabel xml:lang="en">Relative</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/chora#SpatialDeterminationScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.wikidata.org/entity/Q123705">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#ZoneOfAction">
    <skos:altLabel xml:lang="it">Zona dell'Azione</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="en">Several settings or projected spaces logically connected in the narrative by the scholar</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/chora#NarrativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">Zone of Action</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/chora#NarrativeRoleScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#criticalNote">
    <rdfs:comment xml:lang="en">Stores an interpretive or editorial note attached to a spatial interpretation.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
    <skos:prefLabel xml:lang="en">critical note</skos:prefLabel>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <skos:altLabel xml:lang="it">nota critica</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#confidence">
    <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#hasFuzzinessLevel">
    <rdfs:domain rdf:resource="https://w3id.org/chora#NarrativePlace"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has fuzziness level</skos:prefLabel>
    <skos:altLabel xml:lang="it">ha livello di sfocatura</skos:altLabel>
    <rdfs:comment xml:lang="en">Encodes the degree of spatial determination (i.e., how approximate or blurred the place's location is), as an invariant property of the place itself.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#presentLocation">
    <skos:altLabel xml:lang="it">localizzazione attuale</skos:altLabel>
    <rdfs:domain rdf:resource="https://w3id.org/chora#GazetteerEntity"/>
    <rdfs:comment xml:lang="en">Describes the present-day location or administrative context of a gazetteer entity.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">present location</skos:prefLabel>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#hasInterpretation">
    <rdfs:range rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
    <skos:prefLabel xml:lang="en">has interpretation</skos:prefLabel>
    <rdfs:domain rdf:resource="https://w3id.org/chora#PlaceReference"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/chora#interpretsReference"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#Indeterminate">
    <skos:altLabel xml:lang="it">Indeterminata</skos:altLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/chora#SpatialDeterminationScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:prefLabel xml:lang="en">Indeterminate</skos:prefLabel>
    <owl:differentFrom rdf:resource="https://w3id.org/chora#Precise"/>
    <owl:differentFrom rdf:resource="https://w3id.org/chora#Relative"/>
    <skos:inScheme rdf:resource="https://w3id.org/chora#SpatialDeterminationScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora">
    <owl:versionIRI rdf:resource="https://w3id.org/chora/1.0.0"/>
    <vann:preferredNamespaceUri>https://w3id.org/chora#</vann:preferredNamespaceUri>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov-o"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/chora/vocab/placecategory"/>
    <vann:preferredNamespacePrefix>chora</vann:preferredNamespacePrefix>
    <dcterms:publisher rdf:resource="https://ror.org/01111rn36"/>
    <dc:creator rdf:resource="https://orcid.org/0009-0007-1496-722X"/>
    <dcterms:bibliographicCitation xml:lang="en">[Sabatino, Lorenzo]. (2026). CHORA - an Ontology for Narrative Spatiality. Università di Bologna.</dcterms:bibliographicCitation>
    <rdfs:label>CHORA — an Ontology for Narrative Spatiality</rdfs:label>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-11</dcterms:modified>
    <dcterms:contributor rdf:nodeID="cb0"/>
    <dcterms:contributor rdf:nodeID="cb3e50fe09e2ec1e9344cc78de8b58905485ecc149d928857a50b681b56a94d9fc"/>
    <rdfs:comment xml:lang="en">CHORA reuses terms from SKOS, PROV-O, GeoSPARQL, and Web Annotation without importing the complete ontologies, to maintain lightweight reasoning and avoid unintended inferences.</rdfs:comment>
    <dc:title>CHORA — an Ontology for Narrative Spatiality</dc:title>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dc:description xml:lang="en">An ontology for modelling narrative spatiality in modern and contemporary literatures, integrating place references, critical spatial interpretations, and geographic anchoring across a three-tier data model.</dc:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#hasGender">
    <skos:altLabel xml:lang="it">ha genere</skos:altLabel>
    <rdfs:domain rdf:resource="https://w3id.org/chora#FocalizingAgent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:prefLabel xml:lang="en">has gender</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#NarrativeRoleScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/chora#ZoneOfAction"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/chora#Setting"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/chora#Route"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/chora#ProjectedSpace"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/chora#Marker"/>
    <rdfs:label xml:lang="en">Narrative Role</rdfs:label>
    <skos:prefLabel xml:lang="en">Narrative Role</skos:prefLabel>
    <skos:altLabel xml:lang="it">Ruolo Narrativo</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#AdjacentTo">
    <dcterms:description xml:lang="it">A è adiacente a B, i loro confini si toccano senza sovrapporsi.</dcterms:description>
    <skos:inScheme rdf:resource="https://w3id.org/chora#SpatialRelationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Adjacent to</skos:prefLabel>
    <rdfs:comment>Basato su RCC-8 EC (Externally Connected) e GeoSPARQL sfTouches</rdfs:comment>
    <skos:topConceptOf rdf:resource="https://w3id.org/chora#SpatialRelationTypeScheme"/>
    <skos:altLabel xml:lang="it">Adiacente a</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#RelatedTo">
    <skos:topConceptOf rdf:resource="https://w3id.org/chora#SpatialRelationTypeScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="it">In relazione con</skos:altLabel>
    <dcterms:description xml:lang="it">Relazione spaziale generica tra A e B, non ulteriormente specificata sul piano topologico.</dcterms:description>
    <skos:prefLabel xml:lang="en">Related to</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/chora#SpatialRelationTypeScheme"/>
  </rdf:Description>
