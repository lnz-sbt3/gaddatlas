<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/chora#"
     xml:base="https://w3id.org/chora"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:schema="https://schema.org/"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/chora">
        <owl:versionIRI rdf:resource="https://w3id.org/chora/1.0.0"/>
        <dc:creator rdf:resource="https://orcid.org/0009-0007-1496-722X"/>
        <dc:description xml:lang="en">An ontology for modelling narrative spatiality in modern and contemporary literatures, integrating place references, critical spatial interpretations, and geographic anchoring across a three-tier data model.</dc:description>
        <dc:title>CHORA — an Ontology for Narrative Spatiality</dc:title>
        <dcterms:bibliographicCitation xml:lang="en">[Sabatino, Lorenzo]. (2026). CHORA - an Ontology for Narrative Spatiality. Università di Bologna.</dcterms:bibliographicCitation>
        <dcterms:contributor>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/ns/prov#Agent"/>
                <schema:name>Paola Maria Carmela Italia</schema:name>
            </rdf:Description>
        </dcterms:contributor>
        <dcterms:contributor>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/ns/prov#Agent"/>
                <schema:name>Francesca Tomasi</schema:name>
            </rdf:Description>
        </dcterms:contributor>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-01</dcterms:created>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-11</dcterms:modified>
        <dcterms:publisher rdf:resource="https://ror.org/01111rn36"/>
        <vann:preferredNamespacePrefix>chora</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/chora#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">CHORA reuses terms from SKOS, PROV-O, GeoSPARQL, and Web Annotation without importing the complete ontologies, to maintain lightweight reasoning and avoid unintended inferences.</rdfs:comment>
        <rdfs:label>CHORA — an Ontology for Narrative Spatiality</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov-o"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/chora/vocab/placecategory"/>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/bibliographicCitation -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
    


    <!-- http://purl.org/dc/terms/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/references -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/references">
        <rdfs:comment xml:lang="en">Links a property to the SKOS ConceptScheme from which its values are drawn. The rdfs:range of these properties is the generic skos:Concept; this annotation states which controlled vocabulary is actually admissible, and drives the cross-links in the generated documentation.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#broadMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#closeMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#exactMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#hasTopConcept -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#hasTopConcept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#narrowMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#narrowMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#topConceptOf -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#topConceptOf"/>
    


    <!-- https://schema.org/name -->

    <owl:AnnotationProperty rdf:about="https://schema.org/name"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.opengis.net/ont/geosparql#hasGeometry -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/chora#hasSpatialGeometry"/>
        <rdfs:domain rdf:resource="https://w3id.org/chora#GazetteerEntity"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <skos:prefLabel xml:lang="en">has geometry</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasAttributedTo -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#anchorsToEntity -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#anchorsToEntity">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="https://w3id.org/chora#GazetteerEntity"/>
        <skos:prefLabel xml:lang="en">anchors to entity</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#appearsInWork -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#appearsInWork">
        <rdfs:domain rdf:resource="https://w3id.org/chora#PlaceReference"/>
        <rdfs:range rdf:resource="https://w3id.org/chora#LiteraryWork"/>
        <rdfs:label xml:lang="en">appears in work</rdfs:label>
        <skos:altLabel xml:lang="it">compare nell&apos;opera</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#assignsNarrativeRole -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#assignsNarrativeRole">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <dcterms:references rdf:resource="https://w3id.org/chora#NarrativeRoleScheme"/>
        <rdfs:comment xml:lang="en">Assigns a narrative role to a place reference as part of a critical spatial interpretation.</rdfs:comment>
        <skos:altLabel xml:lang="it">assegna ruolo narrativo</skos:altLabel>
        <skos:prefLabel xml:lang="en">assigns narrative role</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#assignsSpatialDetermination -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#assignsSpatialDetermination">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <dcterms:references rdf:resource="https://w3id.org/chora#SpatialDeterminationScheme"/>
        <rdfs:comment xml:lang="en">Assigns a degree of spatial determination (precise, approximate, relative, indeterminate) as part of a critical interpretation.</rdfs:comment>
        <skos:altLabel xml:lang="it">assegna determinazione spaziale</skos:altLabel>
        <skos:prefLabel xml:lang="en">assigns spatial determination</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#assignsSpatialRelationType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#assignsSpatialRelationType">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <dcterms:references rdf:resource="https://w3id.org/chora#SpatialRelationTypeScheme"/>
        <skos:prefLabel xml:lang="en">assigns spatial relation type</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#hasFocalizer -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#hasFocalizer">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="https://w3id.org/chora#FocalizingAgent"/>
        <rdfs:comment xml:lang="it">Collega una SpatialInterpretation all&apos;agente attraverso cui lo spazio è percepito; la coppia luogo×focalizzatore è l&apos;unità base del dataset.</rdfs:comment>
        <skos:altLabel xml:lang="it">ha focalizzatore</skos:altLabel>
        <skos:prefLabel xml:lang="en">has focalizer</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#hasInterpretation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#hasInterpretation">
        <owl:inverseOf rdf:resource="https://w3id.org/chora#interpretsReference"/>
        <rdfs:domain rdf:resource="https://w3id.org/chora#PlaceReference"/>
        <rdfs:range rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <skos:prefLabel xml:lang="en">has interpretation</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#hasPlaceCategory -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#hasPlaceCategory">
        <rdfs:domain rdf:resource="https://w3id.org/chora#NarrativePlace"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <dcterms:references rdf:resource="https://w3id.org/chora#PlaceCategoryScheme"/>
        <rdfs:comment xml:lang="en">Assigns a place category from a controlled vocabulary to any narrative place (discrete or vague).</rdfs:comment>
        <skos:altLabel xml:lang="it">categoria di luogo</skos:altLabel>
        <skos:prefLabel xml:lang="en">has place category</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#hasRealityStatus -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#hasRealityStatus">
        <rdfs:domain rdf:resource="https://w3id.org/chora#NarrativePlace"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <dcterms:references rdf:resource="https://w3id.org/chora#RealityStatusScheme"/>
        <rdfs:comment xml:lang="en">Assigns the reality–fiction status (imported, transformed, imagined, invented) of a narrative place. This is an invariant property of the place as an authorial transposition of the real world into the text, NOT dependent on focalizer or interpretation.</rdfs:comment>
        <skos:altLabel xml:lang="it">ha stato di realtà</skos:altLabel>
        <skos:prefLabel xml:lang="en">has reality status</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#hasSpatialGeometry -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#hasSpatialGeometry">
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <skos:altLabel xml:lang="it">ha geometria spaziale</skos:altLabel>
        <skos:prefLabel xml:lang="en">has spatial geometry</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#interpretsReference -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#interpretsReference">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="https://w3id.org/chora#PlaceReference"/>
        <rdfs:comment xml:lang="en">Links a spatial interpretation to the specific textual place reference it interprets</rdfs:comment>
        <skos:altLabel xml:lang="it">interpreta il riferimento</skos:altLabel>
        <skos:prefLabel xml:lang="en">interprets reference</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#isNodeOfRoute -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#isNodeOfRoute">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="https://w3id.org/chora#NarrativeRoute"/>
        <rdfs:comment xml:lang="en">Declares that a spatial interpretation is a node (stop) of a narrative route. The node&apos;s place is reached via targetsPlace; its position via routeOrder; its focalizer via hasFocalizer. The route of a node and the node share the same focalizer.</rdfs:comment>
        <skos:altLabel xml:lang="it">è nodo del tragitto</skos:altLabel>
        <skos:prefLabel xml:lang="en">is node of route</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#isPartOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#isPartOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/chora#NarrativePlace"/>
        <rdfs:range rdf:resource="https://w3id.org/chora#NarrativePlace"/>
        <rdfs:comment xml:lang="en">Meronymic relation between narrative places: the subject place is a structural component of the object place (e.g. a staircase of a building). Invariant with respect to focalizer. A place with isPartOf inherits its geographic anchoring from the parent and should NOT carry its own anchorsToEntity.</rdfs:comment>
        <skos:altLabel xml:lang="it">è parte di</skos:altLabel>
        <skos:prefLabel xml:lang="en">is part of</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#mentionedInChapter -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#mentionedInChapter">
        <rdfs:domain rdf:resource="https://w3id.org/chora#PlaceReference"/>
        <rdfs:range rdf:resource="https://w3id.org/chora#Chapter"/>
        <skos:altLabel xml:lang="it">è citato nel capitolo</skos:altLabel>
        <skos:prefLabel xml:lang="en">mentioned in Chapter</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#partOfWork -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#partOfWork">
        <rdfs:domain rdf:resource="https://w3id.org/chora#Chapter"/>
        <rdfs:range rdf:resource="https://w3id.org/chora#LiteraryWork"/>
        <rdfs:comment xml:lang="en">Relates a chapter to the literary work it belongs to.</rdfs:comment>
        <skos:altLabel xml:lang="it">fa parte dell&apos;opera</skos:altLabel>
        <skos:prefLabel xml:lang="en">part of work</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#targetsPlace -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#targetsPlace">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="https://w3id.org/chora#NarrativePlace"/>
        <rdfs:comment xml:lang="en">Links a spatial interpretation to the diegetic narrative place it activates.</rdfs:comment>
        <skos:altLabel xml:lang="it">ha come target il luogo</skos:altLabel>
        <skos:prefLabel xml:lang="en">targets place</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/chora#targetsRoute -->

    <owl:ObjectProperty rdf:about="https://w3id.org/chora#targetsRoute">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="https://w3id.org/chora#NarrativeRoute"/>
        <rdfs:comment xml:lang="en">Links a spatial interpretation to the narrative route it activates (used for route-level rows, where narrative role is &apos;route&apos;), as the analogue of targetsPlace for routes.</rdfs:comment>
        <skos:altLabel xml:lang="it">ha come target il tragitto</skos:altLabel>
        <skos:prefLabel xml:lang="en">targets route</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.opengis.net/ont/geosparql#asGeoJSON -->

    <owl:DatatypeProperty rdf:about="http://www.opengis.net/ont/geosparql#asGeoJSON">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#lat -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#lat">
        <rdfs:domain rdf:resource="https://w3id.org/chora#GazetteerEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:altLabel xml:lang="it">latitudine</skos:altLabel>
        <skos:prefLabel xml:lang="en">latitude</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#long -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#long">
        <rdfs:domain rdf:resource="https://w3id.org/chora#GazetteerEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:altLabel xml:lang="it">longitudine</skos:altLabel>
        <skos:prefLabel xml:lang="en">longitude</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#annotationMethod -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#annotationMethod">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Records the method or procedure used to create a spatial interpretation.</rdfs:comment>
        <skos:altLabel xml:lang="it">metodo di annotazione</skos:altLabel>
        <skos:prefLabel xml:lang="en">annotation method</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#chapterNumber -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#chapterNumber">
        <rdfs:domain rdf:resource="https://w3id.org/chora#Chapter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <skos:altLabel xml:lang="it">numero capitolo</skos:altLabel>
        <skos:prefLabel xml:lang="en">chapter number</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#characterName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#characterName">
        <rdfs:domain rdf:resource="https://w3id.org/chora#FocalizingAgent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:altLabel xml:lang="it">nome personaggio</skos:altLabel>
        <skos:prefLabel xml:lang="en">character name</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#confidence -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#confidence">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#criticalNote -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#criticalNote">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">Stores an interpretive or editorial note attached to a spatial interpretation.</rdfs:comment>
        <skos:altLabel xml:lang="it">nota critica</skos:altLabel>
        <skos:prefLabel xml:lang="en">critical note</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#evidenceSource -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#evidenceSource">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">Records textual or critical evidence supporting a spatial interpretation.</rdfs:comment>
        <skos:altLabel xml:lang="it">fonte dell evidenza</skos:altLabel>
        <skos:prefLabel xml:lang="en">evidence source</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#excerpt -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#excerpt">
        <rdfs:domain rdf:resource="https://w3id.org/chora#PlaceReference"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <skos:altLabel xml:lang="it">estratto</skos:altLabel>
        <skos:prefLabel xml:lang="en">excerpt</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#hasFuzzinessLevel -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#hasFuzzinessLevel">
        <rdfs:domain rdf:resource="https://w3id.org/chora#NarrativePlace"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Encodes the degree of spatial determination (i.e., how approximate or blurred the place&apos;s location is), as an invariant property of the place itself.</rdfs:comment>
        <skos:altLabel xml:lang="it">ha livello di sfocatura</skos:altLabel>
        <skos:prefLabel xml:lang="en">has fuzziness level</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#hasGender -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#hasGender">
        <rdfs:domain rdf:resource="https://w3id.org/chora#FocalizingAgent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:altLabel xml:lang="it">ha genere</skos:altLabel>
        <skos:prefLabel xml:lang="en">has gender</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#historicalLocation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#historicalLocation">
        <rdfs:domain rdf:resource="https://w3id.org/chora#GazetteerEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">Describes the historical location or historical-toponymic context of a gazetteer entity.</rdfs:comment>
        <skos:altLabel xml:lang="it">localizzazione storica</skos:altLabel>
        <skos:prefLabel xml:lang="en">historical location</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#interpretationType -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#interpretationType">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Classifies the kind of spatial interpretation asserted by the annotation.</rdfs:comment>
        <skos:altLabel xml:lang="it">tipo di interpretazione</skos:altLabel>
        <skos:prefLabel xml:lang="en">interpretation type</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#narratorType -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#narratorType">
        <rdfs:domain rdf:resource="https://w3id.org/chora#FocalizingAgent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:altLabel xml:lang="it">tipo di narratore</skos:altLabel>
        <skos:prefLabel xml:lang="en">narrator type</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#pageRange -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#pageRange">
        <rdfs:domain rdf:resource="https://w3id.org/chora#Chapter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:altLabel xml:lang="it">intervallo di pagine</skos:altLabel>
        <skos:prefLabel xml:lang="en">page range</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#presentLocation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#presentLocation">
        <rdfs:domain rdf:resource="https://w3id.org/chora#GazetteerEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">Describes the present-day location or administrative context of a gazetteer entity.</rdfs:comment>
        <skos:altLabel xml:lang="it">localizzazione attuale</skos:altLabel>
        <skos:prefLabel xml:lang="en">present location</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#routeOrder -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#routeOrder">
        <rdfs:domain rdf:resource="https://w3id.org/chora#SpatialInterpretation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Ordinal position (1-based) of a node within its narrative route. Meaningful only together with isNodeOfRoute.</rdfs:comment>
        <skos:prefLabel xml:lang="en">route order</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/chora#sourceReference -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/chora#sourceReference">
        <rdfs:domain rdf:resource="https://w3id.org/chora#PlaceReference"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


