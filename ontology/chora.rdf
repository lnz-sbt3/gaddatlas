  <rdf:Description rdf:about="https://w3id.org/chora#hasRealityStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:altLabel xml:lang="it">ha stato di realtà</skos:altLabel>
    <rdfs:domain rdf:resource="https://w3id.org/chora#NarrativePlace"/>
    <skos:prefLabel xml:lang="en">has reality status</skos:prefLabel>
    <rdfs:comment xml:lang="en">Assigns the reality–fiction status (imported, transformed, imagined, invented) of a narrative place. This is an invariant property of the place as an authorial transposition of the real world into the text, NOT dependent on focalizer or interpretation.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dcterms:references rdf:resource="https://w3id.org/chora#RealityStatusScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.getty.edu/aat/300007557">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#Imported">
    <skos:topConceptOf rdf:resource="https://w3id.org/chora#RealityStatusScheme"/>
    <owl:differentFrom rdf:resource="https://w3id.org/chora#Transformed"/>
    <owl:differentFrom rdf:resource="https://w3id.org/chora#Invented"/>
    <skos:definition>The setting corresponds with the geographical reality by realistically portraying the surrounding</skos:definition>
    <skos:prefLabel xml:lang="en">Imported</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="it">Importato</skos:altLabel>
    <skos:inScheme rdf:resource="https://w3id.org/chora#RealityStatusScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.getty.edu/aat/300006165">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/chora#SpatialRelationTypeScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/chora#Contains"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/chora#Below"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/chora#Overlaps"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/chora#RelatedTo"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/chora#Above"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/chora#AdjacentTo"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/chora#Inside"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/chora#Near"/>
    <rdfs:label xml:lang="en">Narrative Spatial Relations</rdfs:label>
    <dcterms:description xml:lang="it">Vocabolario di relazioni spaziali per analisi letteraria, basato su RCC-8 (Randell et al. 1992), GeoSPARQL (W3C/OGC 2012), e narratologia spaziale (Ryan 2001, Herman 2002)</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:prefLabel xml:lang="en">Narrative Spatial Relations</skos:prefLabel>
    <skos:altLabel xml:lang="it">Relazioni Spaziali Narrative</skos:altLabel>
  </rdf:Description>
