    },
    {
      "@id": "dcterms:description",
      "@type": "owl:AnnotationProperty"
    },
    {
      "@id": "http://vocab.getty.edu/aat/300005390",
      "@type": "owl:NamedIndividual"
    },
    {
      "@id": "https://w3id.org/chora#SpatialInterpretation",
      "@type": "owl:Class",
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "SpatialInterpretation makes the declarative and traceable nature of annotation explicit: multiple interpretations may coexist for the same PlaceReference, with different assumptions and confidence levels; therefore the model privileges “targets/assigns/anchors” properties at this level."
        },
        {
          "@language": "it",
          "@value": "SpatialInterpretation esplicita la natura dichiarativa e tracciabile dell’annotazione: diverse interpretazioni possono coesistere per lo stesso PlaceReference, con diverse assunzioni e livelli di confidenza; per questo il modello privilegia proprietà “targets/assigns/anchors” a questo livello."
        }
      ],
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      },
      "skos:definition": [
        {
          "@language": "en",
          "@value": "An interpretive act that operates on a PlaceReference and asserts (i) the diegetic place it activates (target), (ii) semantic qualifications via controlled vocabularies (e.g., narrative role, reality status, degree of spatial determination, spatial relation type), and (iii) any anchoring to an external topographic referent (gazetteer)."
        },
        {
          "@language": "it",
          "@value": "Atto interpretativo che prende in carico un PlaceReference e asserisce (i) quale luogo diegetico esso attiva (target), (ii) le qualificazioni semantiche tramite vocabolari controllati (es. ruolo narrativo, status di realtà, grado di determinazione spaziale, tipo di relazione spaziale), e (iii) l’eventuale ancoraggio a un referente topografico esterno (gazetteer)."
        }
      ]
    },
