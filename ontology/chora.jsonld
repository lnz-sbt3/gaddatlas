        "@id": "chora:AttributionRoleScheme"
      }
    },
    {
      "@id": "chora:EncodingActivity",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The encoding of a reading in the knowledge graph by an annotator, distinct from the interpretation act when the author of the reading is someone else. It uses the source (prov:used) and is informed by the interpretation act (prov:wasInformedBy); its date is the date of the encoding."
      },
      "rdfs:subClassOf": {
        "@id": "prov:Activity"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Codifica"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Encoding activity"
      }
    },
    {
      "@id": "chora:Facing",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "dcterms:description": {
        "@language": "it",
        "@value": "A sta di fronte a B («in faccia», «rimpetto»): relazione frontale, orientata."
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Di fronte a"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialRelationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Facing"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialRelationTypeScheme"
      }
    },
    {
      "@id": "chora:FirstEdition",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "princeps"
      },
      "skos:inScheme": {
        "@id": "chora:WitnessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "First edition"
      },
      "skos:topConceptOf": {
        "@id": "chora:WitnessTypeScheme"
      }
    },
    {
      "@id": "chora:FocalizingAgent",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "it",
        "@value": "Entità attraverso cui lo spazio è percepito/descritto"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Agente Focalizzatore"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Focalizing Agent"
      }
    },
    {
      "@id": "chora:GazetteerEntity",
      "@type": "owl:Class",
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "GazetteerEntity does not belong to the world of the text: it models the external topographic counterpart. The relation to a NarrativePlace is not assumed as identity but as a typed anchoring, asserted by SpatialInterpretation."
        },
        {
          "@language": "it",
          "@value": "GazetteerEntity non appartiene al mondo del testo: modella la controparte topografica esterna. La relazione con NarrativePlace non è assunta come identità, ma come ancoraggio tipizzato, espresso da SpatialInterpretation."
        }
      ],
      "skos:definition": [
        {
          "@language": "en",
          "@value": "An extra-textual georeferenceable place described as an authority/gazetteer entity, typically endowed with stable geometry (coordinates or GeoJSON) and persistent identifiers; it provides the external topographic referent to which narrative places may be anchored."
        },
        {
          "@language": "it",
          "@value": "Luogo extra-testuale georeferenziabile, descritto come entità di authority/gazetteer e tipicamente dotato di geometria stabile (coordinate o GeoJSON) e identificatori persistenti; costituisce il referente topografico esterno a cui possono essere ancorati i luoghi narrativi."
        }
      ]
    },
    {
      "@id": "chora:GeometryAxis",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "geometria"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Uncertainty about the position or extent."
      },
      "skos:inScheme": {
        "@id": "chora:UncertaintyAxisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Geometry Axis"
      },
      "skos:topConceptOf": {
        "@id": "chora:UncertaintyAxisScheme"
      }
    },
    {
      "@id": "chora:IdentificationAssertion",
      "@type": [
        "hico:InterpretationType",
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "chora:reifiesProperty": {
        "@id": "chora:identifiedWith"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "identificazione"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Identifies a narrative place or a place reference with a gazetteer entity. Replaces owl:sameAs as a judgement of identity."
      },
      "skos:inScheme": {
        "@id": "chora:AssertionTypeScheme"
      },
      "skos:notation": "identification",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Identification assertion"
      },
      "skos:topConceptOf": {
        "@id": "chora:AssertionTypeScheme"
      }
    },
    {
      "@id": "chora:IdentificationAxis",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "identificazione"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Uncertainty about which referent is meant."
      },
      "skos:inScheme": {
        "@id": "chora:UncertaintyAxisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Identification Axis"
      },
      "skos:topConceptOf": {
        "@id": "chora:UncertaintyAxisScheme"
      }
    },
    {
      "@id": "chora:Imagined",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": [
        {
          "@id": "chora:Imported"
        },
        {
          "@id": "chora:Invented"
        },
        {
          "@id": "chora:Transformed"
        }
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Immaginato"
      },
      "skos:definition": [
        {
          "@language": "en",
          "@value": "A place without any identifiable correspondence to a place attested in reality: the product of the author's imagination. It may be set in the real world, if the author imagines it in a certain position, but in reality nothing exists at that point."
        },
        {
          "@language": "it",
          "@value": "Luogo senza alcuna corrispondenza identificabile con un luogo attestato nella realtà, frutto dell'immaginazione d'autore. Può essere collocato nel mondo reale, se l'autore lo immagina in una certa posizione, ma nella realtà in quel punto non esiste."
        }
      ],
      "skos:inScheme": {
        "@id": "chora:RealityStatusScheme"
      },
      "skos:notation": "4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Imagined"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Fourth and most abstract degree of the scale: the place has no identifiable counterpart in reality, even when the author gives it a position. Not to be confused with Invented, a fictional place located within a known geography (Reuschel, Piatti and Hurni 2013, pp. 138–139; definition of Imagined by L. Sabatino, 9/10/2026, D-061)."
      },
      "skos:topConceptOf": {
        "@id": "chora:RealityStatusScheme"
      }
    },
    {
      "@id": "chora:Imported",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": [
        {
          "@id": "chora:Imagined"
        },
        {
          "@id": "chora:Invented"
        },
        {
          "@id": "chora:Transformed"
        }
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Importato"
      },
      "skos:definition": "The setting corresponds with the geographical reality by realistically portraying the surrounding",
      "skos:inScheme": {
        "@id": "chora:RealityStatusScheme"
      },
      "skos:notation": "1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Imported"
      },
      "skos:scopeNote": {
        "@language": "it",
        "@value": "Motivazione standard dello statuto (D-046): referente identificato nel repertorio. Per un luogo Imported senza un'asserzione di statuto esplicita, l'ETL genera la lettura (assertion/S-auto-{luogo}) con questa motivazione, la fonte del repertorio dell'ancora primaria se registrata, autore e codificatore L. Sabatino, adottata e validata (D-068)."
      },
      "skos:topConceptOf": {
        "@id": "chora:RealityStatusScheme"
      }
    },
    {
      "@id": "chora:Incompleteness",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "incompletezza"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Information needed to locate or identify the place is missing in the sources."
      },
      "skos:inScheme": {
        "@id": "chora:UncertaintyTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Incompleteness"
      },
      "skos:topConceptOf": {
        "@id": "chora:UncertaintyTypeScheme"
      }
    },
    {
      "@id": "chora:Indeterminate",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": [
        {
          "@id": "chora:Precise"
        },
        {
          "@id": "chora:Relative"
        }
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Indeterminata"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialDeterminationScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Indeterminate"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialDeterminationScheme"
      }
    },
    {
      "@id": "chora:IndicatedRoute",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "indicato"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A route described to a character by another, as directions."
      },
      "skos:inScheme": {
        "@id": "chora:RouteTypeScheme"
      },
      "skos:notation": "2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Indicated"
      },
      "skos:topConceptOf": {
        "@id": "chora:RouteTypeScheme"
      }
    },
    {
      "@id": "chora:InferredRoute",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "inferito"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A route reconstructed by a character or the narrator from traces or hypotheses, not narrated as travelled."
      },
      "skos:inScheme": {
        "@id": "chora:RouteTypeScheme"
      },
      "skos:notation": "4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Inferred"
      },
      "skos:topConceptOf": {
        "@id": "chora:RouteTypeScheme"
      }
    },
    {
      "@id": "chora:Inside",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "dcterms:description": {
        "@language": "it",
        "@value": "A è contenuto spazialmente in B. Relazione topologica di contenimento."
      },
      "rdfs:comment": {
        "@language": "it",
        "@value": "Basato su RCC-8 TPP (Tangential Proper Part) e GeoSPARQL sfWithin"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Dentro"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialRelationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Inside"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialRelationTypeScheme"
      }
    },
    {
      "@id": "chora:InternalDiscrepancy",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "discrepanza interna"
      },
      "skos:broader": {
        "@id": "chora:Discrepancy"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Two passages of the text are mutually incompatible."
      },
      "skos:inScheme": {
        "@id": "chora:UncertaintyTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Internal Discrepancy"
      }
    },
    {
      "@id": "chora:Invented",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": [
        {
          "@id": "chora:Imagined"
        },
        {
          "@id": "chora:Imported"
        },
        {
          "@id": "chora:Transformed"
        }
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Inventato"
      },
      "skos:definition": "An invented setting within familiar geographical reality",
      "skos:inScheme": {
        "@id": "chora:RealityStatusScheme"
      },
      "skos:notation": "3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Invented"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Third degree of the scale: a fictional place set within a known, identifiable geography, so that its position can be indicated or inferred. Not to be confused with Imagined, which has no identifiable counterpart in reality (Reuschel, Piatti and Hurni 2013, pp. 138–139; D-061)."
      },
      "skos:topConceptOf": {
        "@id": "chora:RealityStatusScheme"
      }
    },
    {
      "@id": "chora:LiteraryWork",
      "@type": "owl:Class"
    },
    {
      "@id": "chora:LocalizationStatusScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Localization status"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Stato di localizzazione"
      },
      "skos:hasTopConcept": [
        {
          "@id": "chora:NotApplicable"
        },
        {
          "@id": "chora:NotYetAnalysed"
        },
        {
          "@id": "chora:SuspendedWithReason"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Localization status"
      }
    },
    {
      "@id": "chora:LocationAssertion",
      "@type": [
        "hico:InterpretationType",
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "chora:reifiesProperty": {
        "@id": "geo:hasGeometry"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "posizione"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Locates a gazetteer entity according to a dated repertory."
      },
      "skos:inScheme": {
        "@id": "chora:AssertionTypeScheme"
      },
      "skos:notation": "location",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Location assertion"
      },
      "skos:topConceptOf": {
        "@id": "chora:AssertionTypeScheme"
      }
    },
    {
      "@id": "chora:Marker",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": [
        {
          "@id": "chora:ProjectedSpace"
        },
        {
          "@id": "chora:Setting"
        }
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Marcatore"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Place only mentioned in passing, without active role in the plot"
      },
      "skos:inScheme": {
        "@id": "chora:NarrativeRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Marker"
      },
      "skos:topConceptOf": {
        "@id": "chora:NarrativeRoleScheme"
      }
    },
    {
      "@id": "chora:MemoryAssertion",
      "@type": [
        "hico:InterpretationType",
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "chora:reifiesProperty": {
        "@id": "chora:memoryAttribution"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "memoria"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Attributes a remembered or projected space to the author, to a character, or declares it undecidable."
      },
      "skos:inScheme": {
        "@id": "chora:AssertionTypeScheme"
      },
      "skos:notation": "memory",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Memory assertion"
      },
      "skos:topConceptOf": {
        "@id": "chora:AssertionTypeScheme"
      }
    },
    {
      "@id": "chora:MemoryAttributionScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Memory attribution"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Attribuzione della memoria"
      },
      "skos:hasTopConcept": [
        {
          "@id": "chora:AuthorMemory"
        },
        {
          "@id": "chora:CharacterMemory"
        },
        {
          "@id": "chora:UndecidableMemory"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Memory attribution"
      }
    },
    {
      "@id": "chora:NameAxis",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "nome"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Uncertainty about the name or its form."
      },
      "skos:inScheme": {
        "@id": "chora:UncertaintyAxisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Name Axis"
      },
      "skos:topConceptOf": {
        "@id": "chora:UncertaintyAxisScheme"
      }
    },
    {
      "@id": "chora:NarrativePlace",
      "@type": "owl:Class",
      "owl:disjointWith": {
        "@id": "chora:PlaceReference"
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "NarrativePlace includes both imported places traceable to real toponyms and invented places that are diegetically localized (e.g., fictional buildings located on a real street). Any topographic correspondence is declared via anchoring to a GazetteerEntity and qualified by status/relations."
        },
        {
          "@language": "en",
          "@value": "NarrativePlace models the spatial unit “in the novel”, distinct from the external topographic referent (GazetteerEntity). The relation between the two planes is expressed through anchoring and typed relations at the level of SpatialInterpretation."
        },
        {
          "@language": "it",
          "@value": "NarrativePlace include sia luoghi importati o riconducibili a toponimi reali, sia luoghi inventati ma diegeticamente localizzati (es. edifici finzionali collocati in una via reale). L’eventuale corrispondenza topografica è dichiarata tramite ancoraggio a GazetteerEntity e qualificata da status/relazioni."
        },
        {
          "@language": "it",
          "@value": "NarrativePlace modella l’unità spaziale “nel romanzo”, distinta dal referente topografico esterno (GazetteerEntity). La relazione fra i due piani è espressa tramite ancoraggi e relazioni tipizzate a livello di SpatialInterpretation."
        }
      ],
      "skos:definition": [
        {
          "@language": "en",
          "@value": "A spatial entity belonging to the world of the text: a place constructed and recognizable within the diegesis, independently of any correspondence with an extra-textual georeferenceable place."
        },
        {
          "@language": "it",
          "@value": "Entità spaziale appartenente al mondo del testo: un luogo costruito e riconoscibile nella diegesi, indipendentemente dalla sua eventuale corrispondenza con un luogo extra-testuale georeferenziabile."
        }
      ]
    },
    {
      "@id": "chora:NarrativeRoleScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Narrative Role"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Ruolo Narrativo"
      },
      "skos:hasTopConcept": [
        {
          "@id": "chora:Marker"
        },
        {
          "@id": "chora:ProjectedSpace"
        },
        {
          "@id": "chora:Route"
        },
        {
          "@id": "chora:Setting"
        },
        {
          "@id": "chora:ZoneOfAction"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Narrative Role"
      }
    },
    {
      "@id": "chora:NarrativeRoute",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A route (tragitto): an ordered aggregate of narrative places traversed by a focalizer. Distinct from NarrativePlace — a route is not a place but a second-order sequence of places. Carries its own interpretations (per focalizer) via SpatialInterpretation, and aggregates ordered nodes via isNodeOfRoute / routeOrder."
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Tragitto"
      },
      "skos:definition": [
        {
          "@language": "en",
          "@value": "A second-order spatial entity representing an ordered path connecting multiple narrative places, as perceived by one or more focalizers."
        },
        {
          "@language": "it",
          "@value": "Entità spaziale di secondo livello che rappresenta un percorso ordinato che connette più luoghi narrativi, così come percepito da uno o più focalizzatori."
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Narrative Route"
      }
    },
    {
      "@id": "chora:Narrator",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "chora:FocalizingAgent"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Narratore"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Narrator"
      }
    },
    {
      "@id": "chora:Near",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "dcterms:description": {
        "@language": "it",
        "@value": "A è in prossimità di B, senza specificare distanza esatta. Relazione qualitativa di vicinanza."
      },
      "rdfs:comment": {
        "@language": "it",
        "@value": "Basato su Distance Relations in narratologia spaziale (Ryan 2001)"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Vicino a"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialRelationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Near"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialRelationTypeScheme"
      }
    },
    {
      "@id": "chora:NonApplicability",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "non-applicabilità"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A coordinate or referent does not apply to this occurrence."
      },
      "skos:inScheme": {
        "@id": "chora:UncertaintyTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Non Applicability"
      },
      "skos:topConceptOf": {
        "@id": "chora:UncertaintyTypeScheme"
      }
    },
    {
      "@id": "chora:NonSpecificity",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "non-specificità"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The text designates one among several candidates without resolving which (e.g. a disjunction)."
      },
      "skos:inScheme": {
        "@id": "chora:UncertaintyTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Non Specificity"
      },
      "skos:topConceptOf": {
        "@id": "chora:UncertaintyTypeScheme"
      }
    },
    {
      "@id": "chora:NotApplicable",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "coordinata non applicabile"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A coordinate does not apply to the place. It is assigned case by case, never derived from the reality status (D-062)."
      },
      "skos:inScheme": {
        "@id": "chora:LocalizationStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Not applicable"
      },
      "skos:topConceptOf": {
        "@id": "chora:LocalizationStatusScheme"
      }
    },
    {
      "@id": "chora:NotYetAnalysed",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "analisi non condotta"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The anchoring has not been analysed yet."
      },
      "skos:inScheme": {
        "@id": "chora:LocalizationStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Not yet analysed"
      },
      "skos:topConceptOf": {
        "@id": "chora:LocalizationStatusScheme"
      }
    },
    {
      "@id": "chora:Overlaps",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "dcterms:description": {
        "@language": "it",
        "@value": "A e B condividono una porzione di spazio senza che l'uno contenga l'altro. Sovrapposizione parziale."
      },
      "rdfs:comment": {
        "@language": "it",
        "@value": "Basato su RCC-8 PO (Partial Overlap) e GeoSPARQL sfOverlaps"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Sovrapposto"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialRelationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Overlaps"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialRelationTypeScheme"
      }
    },
    {
      "@id": "chora:Oversight",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "svista"
      },
      "skos:broader": {
        "@id": "chora:Discrepancy"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A probable slip of the author (e.g. a misplaced accent)."
      },
      "skos:inScheme": {
        "@id": "chora:UncertaintyTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Oversight"
      }
    },
    {
      "@id": "chora:Partition",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "An interpretive partition of the territory (e.g. city / countryside), proposed by a reader. It is a hypothesis: its author, source and adoption are stated by a chora:PartitionAssertion whose subject is the partition."
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Partizione"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Partition"
      }
    },
    {
      "@id": "chora:PartitionAssertion",
      "@type": [
        "hico:InterpretationType",
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "chora:reifiesProperty": {
        "@id": "chora:hasZone"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "partizione"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Assigns a place to an interpretive partition (e.g. city / countryside)."
      },
      "skos:inScheme": {
        "@id": "chora:AssertionTypeScheme"
      },
      "skos:notation": "partition",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Partition assertion"
      },
      "skos:topConceptOf": {
        "@id": "chora:AssertionTypeScheme"
      }
    },
    {
      "@id": "chora:PartitionZone",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "One zone of a chora:Partition. A zone belongs to exactly one partition."
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Zona di una partizione"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Partition zone"
      }
    },
    {
      "@id": "chora:PeriodicalRedaction",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "redazione in rivista"
      },
      "skos:inScheme": {
        "@id": "chora:WitnessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Periodical redaction"
      },
      "skos:topConceptOf": {
        "@id": "chora:WitnessTypeScheme"
      }
    },
    {
      "@id": "chora:PlaceReference",
      "@type": "owl:Class",
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "A PlaceReference does not “resolve” a referent nor determine the place type: disambiguation, classification, and any topographic anchoring are asserted at the level of SpatialInterpretation."
        },
        {
          "@language": "it",
          "@value": "PlaceReference non “risolve” il referente né determina il tipo di luogo: la disambiguazione, la classificazione e l’eventuale ancoraggio topografico sono esplicitati a livello di SpatialInterpretation."
        }
      ],
      "skos:definition": [
        {
          "@language": "en",
          "@value": "A textual occurrence in which the text mentions or evokes a spatial element; it is the basic evidential unit and includes bibliographic and contextual information (e.g., source, page, passage, quotation)."
        },
        {
          "@language": "it",
          "@value": "Occorrenza testuale in cui il testo menziona o richiama un elemento spaziale; costituisce l’unità attestativa di base e include informazioni bibliografiche e contestuali (es. fonte, pagina, segmento, citazione)."
        }
      ]
    },
    {
      "@id": "chora:Precise",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": {
        "@id": "chora:Relative"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Precisa"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialDeterminationScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Precise"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialDeterminationScheme"
      }
    },
    {
      "@id": "chora:ProjectedSpace",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": {
        "@id": "chora:Setting"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Spazio di Proiezione"
      },
      "skos:definition": "Characters are not present in this location, but they dream of, remember, or long for it",
      "skos:inScheme": {
        "@id": "chora:NarrativeRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Projected Space"
      },
      "skos:topConceptOf": {
        "@id": "chora:NarrativeRoleScheme"
      }
    },
    {
      "@id": "chora:Proofs",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "bozze"
      },
      "skos:inScheme": {
        "@id": "chora:WitnessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Proofs"
      },
      "skos:topConceptOf": {
        "@id": "chora:WitnessTypeScheme"
      }
    },
    {
      "@id": "chora:ProposedRoute",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "proposto"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A route a character proposes to take, not (yet) travelled."
      },
      "skos:inScheme": {
        "@id": "chora:RouteTypeScheme"
      },
      "skos:notation": "6",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Proposed"
      },
      "skos:topConceptOf": {
        "@id": "chora:RouteTypeScheme"
      }
    },
    {
      "@id": "chora:RationaleTypeScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Rationale type"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Tipo di motivazione"
      },
      "skos:hasTopConcept": [
        {
          "@id": "chora:CriticalReading"
        },
        {
          "@id": "chora:ReferentialEvidence"
        },
        {
          "@id": "chora:TextualEvidence"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Rationale type"
      }
    },
