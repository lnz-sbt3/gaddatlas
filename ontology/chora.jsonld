        "@language": "en",
        "@value": "Links a spatial interpretation to the diegetic narrative place it activates."
      },
      "rdfs:domain": {
        "@id": "chora:SpatialInterpretation"
      },
      "rdfs:range": {
        "@id": "chora:NarrativePlace"
