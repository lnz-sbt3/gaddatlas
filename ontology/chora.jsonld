    {
      "@id": "chora:Assertion",
      "@type": "owl:Class",
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "An attributed reading about a resource of the dataset (subject, value), generated by an interpretation act (prov:wasGeneratedBy hico:InterpretationAct) that carries its type, criterion, source, rationale and author. The reading itself carries whether the project adopts it, its review status and which earlier reading it revises. Competing readings coexist as distinct assertions; the adopted one is attributed like the others (D-067)."
        },
        {
          "@language": "it",
          "@value": "Lettura attribuita su una risorsa del dataset (soggetto, valore), generata da un atto interpretativo (prov:wasGeneratedBy hico:InterpretationAct) che ne porta tipo, criterio, fonte, argomentazione e autore. La lettura porta l'adozione da parte del progetto, lo stato di revisione e la lettura che rivede. Le letture concorrenti convivono come asserzioni distinte; quella adottata e' attribuita come le altre (D-067)."
        }
      ],
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Asserzione"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Assertion"
      }
    },
