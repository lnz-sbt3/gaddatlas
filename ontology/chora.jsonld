    {
      "@id": "https://w3id.org/chora#isPartOf",
      "@type": [
        "owl:ObjectProperty",
        "owl:TransitiveProperty"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "Meronymic relation between narrative places: the subject place is a structural component of the object place (e.g. a staircase of a building). Invariant with respect to focalizer. A place with isPartOf inherits its geographic anchoring from the parent and should NOT carry its own anchorsToEntity."
      },
      "rdfs:domain": {
        "@id": "https://w3id.org/chora#NarrativePlace"
      },
      "rdfs:range": {
        "@id": "https://w3id.org/chora#NarrativePlace"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "è parte di"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "is part of"
      }
    },
    {
      "@id": "https://w3id.org/chora#interpretationType",
      "@type": "owl:DatatypeProperty",
