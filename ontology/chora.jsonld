        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "dcterms:description": {
        "@language": "it",
        "@value": "A è adiacente a B, i loro confini si toccano senza sovrapporsi."
      },
      "rdfs:comment": "Basato su RCC-8 EC (Externally Connected) e GeoSPARQL sfTouches",
      "skos:altLabel": {
        "@language": "it",
        "@value": "Adiacente a"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialRelationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Adjacent to"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialRelationTypeScheme"
      }
