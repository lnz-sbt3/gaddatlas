    },
    {
      "@id": "chora:hasPlaceCategory",
      "@type": "owl:ObjectProperty",
      "dcterms:references": {
        "@id": "chora:PlaceCategoryScheme"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Assigns a place category from a controlled vocabulary to any narrative place (discrete or vague)."
      },
      "rdfs:domain": {
        "@id": "chora:NarrativePlace"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "categoria di luogo"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has place category"
      }
    },
    {
      "@id": "chora:hasRealityStatus",
      "@type": "owl:ObjectProperty",
      "dcterms:references": {
        "@id": "chora:RealityStatusScheme"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Assigns the reality–fiction status of a narrative place, on a scale ordered from the concrete to the abstract: imported, transformed, invented, imagined (skos:notation 1–4; Reuschel, Piatti and Hurni 2013, pp. 138–139). This is an invariant property of the place as an authorial transposition of the real world into the text, NOT dependent on focalizer or interpretation."
      },
      "rdfs:domain": {
        "@id": "chora:NarrativePlace"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha stato di realtà"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has reality status"
      }
    },
    {
      "@id": "chora:hasSpatialGeometry",
      "@type": "owl:ObjectProperty",
      "rdfs:range": {
        "@id": "geo:Geometry"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha geometria spaziale"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has spatial geometry"
      }
    },
    {
      "@id": "chora:historicalLocation",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Describes the historical location or historical-toponymic context of a gazetteer entity."
      },
      "rdfs:domain": {
        "@id": "chora:GazetteerEntity"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "localizzazione storica"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "historical location"
      }
    },
    {
      "@id": "chora:housedIn",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "An institution (e.g. a police station, a prison) is housed in a site (a building, a street). The two gazetteer entities are distinct referents: this is neither an identity (owl:sameAs) nor an identification assertion, and it never merges them."
        },
        {
          "@language": "it",
          "@value": "Un'istituzione (un commissariato, un carcere) ha sede in un luogo (un edificio, una via). Le due entita' del gazetteer sono referenti distinti: non e' un'identita' (owl:sameAs) ne' un'asserzione d'identificazione, e non le fonde."
        }
      ],
      "rdfs:domain": {
        "@id": "chora:GazetteerEntity"
      },
      "rdfs:range": {
        "@id": "chora:GazetteerEntity"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha sede in"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "housed in"
      }
    },
    {
      "@id": "chora:interpretationType",
      "@type": "owl:DatatypeProperty",
      "owl:deprecated": true,
      "rdfs:comment": {
        "@language": "en",
        "@value": "Classifies the kind of spatial interpretation asserted by the annotation."
      },
      "rdfs:domain": {
        "@id": "chora:SpatialInterpretation"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "tipo di interpretazione"
      },
      "skos:historyNote": {
        "@language": "it",
        "@value": "Deprecata il 9/10/2026 (D-042): il tipo di una lettura e' chora:assertionType su chora:Assertion."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "interpretation type"
      }
    },
    {
      "@id": "chora:interpretsReference",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a spatial interpretation to the specific textual place reference it interprets"
      },
      "rdfs:domain": {
        "@id": "chora:SpatialInterpretation"
      },
      "rdfs:range": {
        "@id": "chora:PlaceReference"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "interpreta il riferimento"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "interprets reference"
      }
    },
    {
      "@id": "chora:isNodeOfRoute",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Declares that a spatial interpretation is a node (stop) of a narrative route. The node's place is reached via targetsPlace; its position via routeOrder; its focalizer via hasFocalizer. The route of a node and the node share the same focalizer."
      },
      "rdfs:domain": {
        "@id": "chora:SpatialInterpretation"
      },
      "rdfs:range": {
        "@id": "chora:NarrativeRoute"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "è nodo del tragitto"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "is node of route"
      }
    },
    {
      "@id": "chora:isPartOf",
      "@type": [
        "owl:ObjectProperty",
        "owl:TransitiveProperty"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "Meronymic relation between narrative places: the subject place is a structural component of the object place (e.g. a staircase of a building). Invariant with respect to focalizer. A place with isPartOf inherits its geographic anchoring from the parent and should NOT carry its own anchorsToEntity."
      },
      "rdfs:domain": {
        "@id": "chora:NarrativePlace"
      },
      "rdfs:range": {
        "@id": "chora:NarrativePlace"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "è parte di"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "is part of"
      }
    },
    {
      "@id": "chora:mentionedInChapter",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "chora:PlaceReference"
      },
      "rdfs:range": {
        "@id": "chora:Chapter"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "è citato nel capitolo"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "mentioned in Chapter"
      }
    },
    {
      "@id": "chora:narratorType",
