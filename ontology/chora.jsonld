    {
      "@id": "chora:GazetteerEntity",
      "@type": "owl:Class",
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "GazetteerEntity does not belong to the world of the text: it models the external topographic counterpart. The relation to a NarrativePlace is not assumed as identity but as a typed anchoring, asserted by SpatialInterpretation."
        },
        {
          "@language": "it",
          "@value": "GazetteerEntity non appartiene al mondo del testo: modella la controparte topografica esterna. La relazione con NarrativePlace non è assunta come identità, ma come ancoraggio tipizzato, espresso da SpatialInterpretation."
        }
      ],
      "skos:definition": [
        {
          "@language": "en",
          "@value": "An extra-textual georeferenceable place described as an authority/gazetteer entity, typically endowed with stable geometry (coordinates or GeoJSON) and persistent identifiers; it provides the external topographic referent to which narrative places may be anchored."
        },
        {
          "@language": "it",
          "@value": "Luogo extra-testuale georeferenziabile, descritto come entità di authority/gazetteer e tipicamente dotato di geometria stabile (coordinate o GeoJSON) e identificatori persistenti; costituisce il referente topografico esterno a cui possono essere ancorati i luoghi narrativi."
        }
      ]
    },
    {
      "@id": "chora:IdentificationAssertion",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "identificazione"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Identifies a narrative place or a place reference with a gazetteer entity. Replaces owl:sameAs as a judgement of identity."
      },
      "skos:inScheme": {
        "@id": "chora:AssertionTypeScheme"
      },
      "skos:notation": "identification",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Identification assertion"
      },
      "skos:topConceptOf": {
        "@id": "chora:AssertionTypeScheme"
      }
    },
    {
      "@id": "chora:Imagined",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": [
        {
          "@id": "chora:Imported"
        },
        {
          "@id": "chora:Invented"
        },
        {
          "@id": "chora:Transformed"
        }
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Immaginato"
      },
      "skos:definition": "There is no hint at all about the position of the setting, it is located ‘somewhere’, with no real-world counterpart, only existing within the narration. Consequently, it is not possible to assign coordinates",
      "skos:inScheme": {
        "@id": "chora:RealityStatusScheme"
      },
      "skos:notation": "4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Imagined"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Fourth and most abstract degree of the scale: the place is set 'somewhere', without any indication of position. Not to be confused with Invented, a fictional place located within a known geography (Reuschel, Piatti and Hurni 2013, pp. 138–139)."
      },
      "skos:topConceptOf": {
        "@id": "chora:RealityStatusScheme"
      }
    },
    {
      "@id": "chora:Imported",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": [
        {
          "@id": "chora:Imagined"
        },
        {
          "@id": "chora:Invented"
        },
        {
          "@id": "chora:Transformed"
        }
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Importato"
      },
      "skos:definition": "The setting corresponds with the geographical reality by realistically portraying the surrounding",
      "skos:inScheme": {
        "@id": "chora:RealityStatusScheme"
      },
      "skos:notation": "1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Imported"
      },
      "skos:scopeNote": {
        "@language": "it",
        "@value": "Motivazione standard dello statuto (D-046): referente identificato nel repertorio. Un luogo Imported non richiede un'asserzione di statuto motivata, salvo i casi contesi."
      },
      "skos:topConceptOf": {
        "@id": "chora:RealityStatusScheme"
      }
    },
    {
      "@id": "chora:Indeterminate",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": [
        {
          "@id": "chora:Precise"
        },
        {
          "@id": "chora:Relative"
        }
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Indeterminata"
      },
      "skos:inScheme": {
