        "@language": "en",
        "@value": "True when the project adopts this reading (the one shown by the interface). It marks a choice, not a truth: the adopted reading is attributed like the others. Stated on every assertion that offers alternatives and on every spatial interpretation, true or false (D-070)."
      },
      "rdfs:domain": {
        "@id": "_:cb1609a098237628e9cfea4eeceb51db3623fb93d7f185c26888e88ec4820c442bf"
