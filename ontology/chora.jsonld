    {
      "@id": "https://ror.org/01111rn36",
      "@type": [
        "owl:NamedIndividual",
        "prov:Agent"
      ],
      "schema:name": "Università di Bologna"
    },
    {
      "@id": "https://w3id.org/chora",
      "@type": "owl:Ontology",
      "dc:creator": {
        "@id": "https://orcid.org/0009-0007-1496-722X"
      },
      "dc:description": {
        "@language": "en",
        "@value": "An ontology for modelling narrative spatiality in modern and contemporary literatures, integrating place references, critical spatial interpretations, and geographic anchoring across a three-tier data model."
      },
      "dc:title": "CHORA — an Ontology for Narrative Spatiality",
      "dcterms:bibliographicCitation": {
        "@language": "en",
        "@value": "[Sabatino, Lorenzo]. (2026). CHORA - an Ontology for Narrative Spatiality. Università di Bologna."
      },
      "dcterms:contributor": [
        {
          "@id": "_:cb108560042ebfadee765c269031a1dc3c7c3c4563864b02b5632113040a9addfa1"
        },
        {
          "@id": "_:cbd6fccde0583b4d389e08d55895ea9035dedc354bac783318d89f5883c74ad587"
        }
      ],
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2025-10-01"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-08-11"
      },
      "dcterms:publisher": {
        "@id": "https://ror.org/01111rn36"
      },
      "owl:versionIRI": {
        "@id": "https://w3id.org/chora/1.0.0"
      },
      "owl:versionInfo": "1.0.0",
      "rdfs:comment": {
        "@language": "en",
        "@value": "CHORA reuses terms from SKOS, PROV-O, GeoSPARQL, and Web Annotation without importing the complete ontologies, to maintain lightweight reasoning and avoid unintended inferences."
      },
      "rdfs:label": "CHORA — an Ontology for Narrative Spatiality",
      "rdfs:seeAlso": [
        {
          "@id": "http://www.w3.org/2004/02/skos/core"
        },
        {
          "@id": "http://www.w3.org/ns/prov-o"
        },
        {
          "@id": "https://w3id.org/chora/vocab/placecategory"
        }
      ],
      "vann:preferredNamespacePrefix": "chora",
      "vann:preferredNamespaceUri": "https://w3id.org/chora#"
