        "@language": "en",
        "@value": "The witness in which a place reference occurs (D-053). Occurrences in witnesses other than the reference witness enter only as comparison corpora: they point to the same narrative place, never count in the views of the published novel, and carry no status of their own."
      },
      "rdfs:domain": {
        "@id": "chora:PlaceReference"
