      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Indeterminate"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialDeterminationScheme"
      }
    },
    {
      "@id": "chora:Inside",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "dcterms:description": {
        "@language": "it",
        "@value": "A è contenuto spazialmente in B. Relazione topologica di contenimento."
      },
      "rdfs:comment": {
        "@language": "it",
        "@value": "Basato su RCC-8 TPP (Tangential Proper Part) e GeoSPARQL sfWithin"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Dentro"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialRelationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Inside"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialRelationTypeScheme"
      }
    },
    {
      "@id": "chora:Invented",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": [
        {
          "@id": "chora:Imagined"
        },
        {
          "@id": "chora:Imported"
        },
        {
          "@id": "chora:Transformed"
        }
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Inventato"
      },
      "skos:definition": "An invented setting within familiar geographical reality",
      "skos:inScheme": {
        "@id": "chora:RealityStatusScheme"
      },
      "skos:notation": "3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Invented"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Third degree of the scale: a fictional place set within a known, identifiable geography, so that its position can be indicated or inferred. Not to be confused with Imagined, which has no indication of position at all (Reuschel, Piatti and Hurni 2013, pp. 138–139)."
      },
      "skos:topConceptOf": {
        "@id": "chora:RealityStatusScheme"
      }
    },
    {
      "@id": "chora:LiteraryWork",
      "@type": "owl:Class"
    },
    {
      "@id": "chora:LocationAssertion",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "posizione"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Locates a gazetteer entity according to a dated repertory."
      },
      "skos:inScheme": {
        "@id": "chora:AssertionTypeScheme"
      },
      "skos:notation": "location",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Location assertion"
      },
      "skos:topConceptOf": {
        "@id": "chora:AssertionTypeScheme"
      }
    },
    {
      "@id": "chora:Marker",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": [
        {
          "@id": "chora:ProjectedSpace"
        },
        {
          "@id": "chora:Setting"
        }
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Marcatore"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Place only mentioned in passing, without active role in the plot"
      },
      "skos:inScheme": {
        "@id": "chora:NarrativeRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Marker"
      },
      "skos:topConceptOf": {
        "@id": "chora:NarrativeRoleScheme"
      }
    },
    {
      "@id": "chora:MemoryAssertion",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "memoria"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Attributes a remembered or projected space to the author, to a character, or declares it undecidable."
      },
      "skos:inScheme": {
        "@id": "chora:AssertionTypeScheme"
      },
      "skos:notation": "memory",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Memory assertion"
      },
      "skos:topConceptOf": {
        "@id": "chora:AssertionTypeScheme"
      }
    },
    {
      "@id": "chora:NarrativePlace",
      "@type": "owl:Class",
      "owl:disjointWith": {
        "@id": "chora:PlaceReference"
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "NarrativePlace includes both imported places traceable to real toponyms and invented places that are diegetically localized (e.g., fictional buildings located on a real street). Any topographic correspondence is declared via anchoring to a GazetteerEntity and qualified by status/relations."
        },
        {
          "@language": "en",
          "@value": "NarrativePlace models the spatial unit “in the novel”, distinct from the external topographic referent (GazetteerEntity). The relation between the two planes is expressed through anchoring and typed relations at the level of SpatialInterpretation."
        },
        {
          "@language": "it",
          "@value": "NarrativePlace include sia luoghi importati o riconducibili a toponimi reali, sia luoghi inventati ma diegeticamente localizzati (es. edifici finzionali collocati in una via reale). L’eventuale corrispondenza topografica è dichiarata tramite ancoraggio a GazetteerEntity e qualificata da status/relazioni."
        },
        {
          "@language": "it",
          "@value": "NarrativePlace modella l’unità spaziale “nel romanzo”, distinta dal referente topografico esterno (GazetteerEntity). La relazione fra i due piani è espressa tramite ancoraggi e relazioni tipizzate a livello di SpatialInterpretation."
        }
      ],
      "skos:definition": [
        {
          "@language": "en",
          "@value": "A spatial entity belonging to the world of the text: a place constructed and recognizable within the diegesis, independently of any correspondence with an extra-textual georeferenceable place."
        },
        {
          "@language": "it",
          "@value": "Entità spaziale appartenente al mondo del testo: un luogo costruito e riconoscibile nella diegesi, indipendentemente dalla sua eventuale corrispondenza con un luogo extra-testuale georeferenziabile."
        }
      ]
    },
    {
      "@id": "chora:NarrativeRoleScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Narrative Role"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Ruolo Narrativo"
      },
      "skos:hasTopConcept": [
        {
          "@id": "chora:Marker"
        },
        {
          "@id": "chora:ProjectedSpace"
        },
        {
          "@id": "chora:Route"
        },
        {
          "@id": "chora:Setting"
        },
        {
          "@id": "chora:ZoneOfAction"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Narrative Role"
      }
    },
    {
      "@id": "chora:NarrativeRoute",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A route (tragitto): an ordered aggregate of narrative places traversed by a focalizer. Distinct from NarrativePlace — a route is not a place but a second-order sequence of places. Carries its own interpretations (per focalizer) via SpatialInterpretation, and aggregates ordered nodes via isNodeOfRoute / routeOrder."
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Tragitto"
      },
      "skos:definition": [
        {
          "@language": "en",
          "@value": "A second-order spatial entity representing an ordered path connecting multiple narrative places, as perceived by one or more focalizers."
        },
        {
          "@language": "it",
          "@value": "Entità spaziale di secondo livello che rappresenta un percorso ordinato che connette più luoghi narrativi, così come percepito da uno o più focalizzatori."
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Narrative Route"
      }
    },
    {
      "@id": "chora:Narrator",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "chora:FocalizingAgent"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Narratore"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Narrator"
      }
    },
    {
      "@id": "chora:Near",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "dcterms:description": {
        "@language": "it",
        "@value": "A è in prossimità di B, senza specificare distanza esatta. Relazione qualitativa di vicinanza."
      },
      "rdfs:comment": {
        "@language": "it",
        "@value": "Basato su Distance Relations in narratologia spaziale (Ryan 2001)"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Vicino a"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialRelationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Near"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialRelationTypeScheme"
      }
    },
    {
      "@id": "chora:Overlaps",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "dcterms:description": {
        "@language": "it",
        "@value": "A e B condividono una porzione di spazio senza che l'uno contenga l'altro. Sovrapposizione parziale."
      },
      "rdfs:comment": {
        "@language": "it",
        "@value": "Basato su RCC-8 PO (Partial Overlap) e GeoSPARQL sfOverlaps"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Sovrapposto"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialRelationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Overlaps"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialRelationTypeScheme"
      }
    },
    {
      "@id": "chora:PartitionAssertion",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "partizione"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Assigns a place to an interpretive partition (e.g. city / countryside)."
      },
      "skos:inScheme": {
        "@id": "chora:AssertionTypeScheme"
      },
      "skos:notation": "partition",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Partition assertion"
      },
      "skos:topConceptOf": {
        "@id": "chora:AssertionTypeScheme"
      }
    },
    {
      "@id": "chora:PlaceReference",
      "@type": "owl:Class",
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "A PlaceReference does not “resolve” a referent nor determine the place type: disambiguation, classification, and any topographic anchoring are asserted at the level of SpatialInterpretation."
        },
        {
          "@language": "it",
          "@value": "PlaceReference non “risolve” il referente né determina il tipo di luogo: la disambiguazione, la classificazione e l’eventuale ancoraggio topografico sono esplicitati a livello di SpatialInterpretation."
        }
      ],
      "skos:definition": [
        {
          "@language": "en",
          "@value": "A textual occurrence in which the text mentions or evokes a spatial element; it is the basic evidential unit and includes bibliographic and contextual information (e.g., source, page, passage, quotation)."
        },
        {
          "@language": "it",
          "@value": "Occorrenza testuale in cui il testo menziona o richiama un elemento spaziale; costituisce l’unità attestativa di base e include informazioni bibliografiche e contestuali (es. fonte, pagina, segmento, citazione)."
        }
      ]
    },
    {
      "@id": "chora:Precise",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": {
        "@id": "chora:Relative"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Precisa"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialDeterminationScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Precise"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialDeterminationScheme"
      }
    },
    {
      "@id": "chora:ProjectedSpace",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": {
        "@id": "chora:Setting"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Spazio di Proiezione"
      },
      "skos:definition": "Characters are not present in this location, but they dream of, remember, or long for it",
      "skos:inScheme": {
        "@id": "chora:NarrativeRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Projected Space"
      },
      "skos:topConceptOf": {
        "@id": "chora:NarrativeRoleScheme"
      }
    },
    {
      "@id": "chora:RationaleTypeScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Rationale type"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Tipo di motivazione"
      },
      "skos:hasTopConcept": [
        {
          "@id": "chora:CriticalReading"
        },
        {
          "@id": "chora:ReferentialEvidence"
        },
        {
          "@id": "chora:TextualEvidence"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Rationale type"
      }
    },
    {
      "@id": "chora:ReadingAuthor",
      "@type": [
        "owl:NamedIndividual",
        "prov:Role",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "autore della lettura"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The agent who formulated the reading: a scholar, or the project when the reading is its own."
      },
      "skos:inScheme": {
        "@id": "chora:AttributionRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Reading author"
      },
      "skos:topConceptOf": {
        "@id": "chora:AttributionRoleScheme"
      }
    },
    {
      "@id": "chora:RealityStatusScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Reality Status"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Stato di Realtà"
      },
      "skos:hasTopConcept": [
        {
          "@id": "chora:Imagined"
        },
        {
          "@id": "chora:Imported"
        },
        {
          "@id": "chora:Invented"
        },
        {
          "@id": "chora:Transformed"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Reality Status"
      }
    },
    {
      "@id": "chora:ReferentialEvidence",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "prova referenziale"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The reading rests on a repertory (map, guide, gazetteer) that documents or excludes the referent."
      },
      "skos:inScheme": {
        "@id": "chora:RationaleTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Referential evidence"
      },
      "skos:topConceptOf": {
        "@id": "chora:RationaleTypeScheme"
      }
    },
    {
      "@id": "chora:RelatedTo",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "dcterms:description": {
        "@language": "it",
        "@value": "Relazione spaziale generica tra A e B, non ulteriormente specificata sul piano topologico."
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "In relazione con"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialRelationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Related to"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialRelationTypeScheme"
      }
    },
    {
      "@id": "chora:Relative",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Relativa"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialDeterminationScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Relative"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialDeterminationScheme"
      }
    },
    {
      "@id": "chora:ReviewStatusScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Review status"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Stato di revisione"
      },
      "skos:hasTopConcept": [
        {
          "@id": "chora:Draft"
        },
        {
          "@id": "chora:Validated"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Review status"
      }
    },
    {
      "@id": "chora:Route",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Percorso"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Path along which characters move, connecting multiple settings or projected spaces"
      },
      "skos:inScheme": {
        "@id": "chora:NarrativeRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Route"
      },
      "skos:topConceptOf": {
        "@id": "chora:NarrativeRoleScheme"
      }
    },
    {
      "@id": "chora:Setting",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Ambientazione"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Place where the action occurs, with characters physically present"
      },
      "skos:inScheme": {
        "@id": "chora:NarrativeRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Setting"
      },
      "skos:topConceptOf": {
        "@id": "chora:NarrativeRoleScheme"
      }
    },
    {
      "@id": "chora:SpatialDeterminationScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Spatial Determination"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Caratterizzazione spaziale"
      },
      "skos:hasTopConcept": [
        {
          "@id": "chora:Approximate"
        },
        {
          "@id": "chora:Indeterminate"
        },
        {
          "@id": "chora:Precise"
        },
        {
          "@id": "chora:Relative"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Spatial determination"
      }
    },
    {
      "@id": "chora:SpatialInterpretation",
      "@type": "owl:Class",
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "SpatialInterpretation makes the declarative and traceable nature of annotation explicit: multiple interpretations may coexist for the same PlaceReference, with different assumptions and confidence levels; therefore the model privileges “targets/assigns/anchors” properties at this level."
        },
        {
          "@language": "it",
          "@value": "SpatialInterpretation esplicita la natura dichiarativa e tracciabile dell’annotazione: diverse interpretazioni possono coesistere per lo stesso PlaceReference, con diverse assunzioni e livelli di confidenza; per questo il modello privilegia proprietà “targets/assigns/anchors” a questo livello."
        }
      ],
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      },
      "skos:definition": [
        {
          "@language": "en",
          "@value": "An interpretive act that operates on a PlaceReference and asserts (i) the diegetic place it activates (target), (ii) semantic qualifications via controlled vocabularies (e.g., narrative role, reality status, degree of spatial determination, spatial relation type), and (iii) any anchoring to an external topographic referent (gazetteer)."
        },
        {
          "@language": "it",
          "@value": "Atto interpretativo che prende in carico un PlaceReference e asserisce (i) quale luogo diegetico esso attiva (target), (ii) le qualificazioni semantiche tramite vocabolari controllati (es. ruolo narrativo, status di realtà, grado di determinazione spaziale, tipo di relazione spaziale), e (iii) l’eventuale ancoraggio a un referente topografico esterno (gazetteer)."
        }
      ]
    },
    {
      "@id": "chora:SpatialRelationTypeScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "dcterms:description": {
        "@language": "it",
        "@value": "Vocabolario di relazioni spaziali per analisi letteraria, basato su RCC-8 (Randell et al. 1992), GeoSPARQL (W3C/OGC 2012), e narratologia spaziale (Ryan 2001, Herman 2002)"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Narrative Spatial Relations"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Relazioni Spaziali Narrative"
      },
      "skos:hasTopConcept": [
        {
          "@id": "chora:Above"
        },
        {
          "@id": "chora:AdjacentTo"
        },
        {
          "@id": "chora:Below"
        },
        {
          "@id": "chora:Contains"
        },
        {
          "@id": "chora:Inside"
        },
        {
          "@id": "chora:Near"
        },
        {
          "@id": "chora:Overlaps"
        },
        {
          "@id": "chora:RelatedTo"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Narrative Spatial Relations"
      }
    },
    {
      "@id": "chora:StatusAssertion",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "statuto"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Assigns a reality status to a narrative place."
      },
      "skos:inScheme": {
        "@id": "chora:AssertionTypeScheme"
      },
      "skos:notation": "status",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Status assertion"
      },
      "skos:topConceptOf": {
        "@id": "chora:AssertionTypeScheme"
      }
    },
    {
      "@id": "chora:TextualEvidence",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "prova testuale"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The reading rests on the text itself (wording, position, context of the occurrences)."
      },
      "skos:inScheme": {
        "@id": "chora:RationaleTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Textual evidence"
      },
      "skos:topConceptOf": {
        "@id": "chora:RationaleTypeScheme"
      }
    },
    {
      "@id": "chora:Transformed",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "owl:differentFrom": [
        {
          "@id": "chora:Imagined"
        },
        {
          "@id": "chora:Imported"
        },
        {
          "@id": "chora:Invented"
        }
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Trasformato"
      },
      "skos:definition": "The setting is transformed, with techniques of remodelling, renaming, relocation or a synthesis of several places",
      "skos:inScheme": {
        "@id": "chora:RealityStatusScheme"
      },
      "skos:notation": "2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Transformed"
      },
      "skos:topConceptOf": {
        "@id": "chora:RealityStatusScheme"
      }
    },
    {
      "@id": "chora:UncertaintyAssertion",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "incertezza"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Qualifies the uncertainty of a reading by type, axis and origin."
      },
      "skos:inScheme": {
        "@id": "chora:AssertionTypeScheme"
      },
      "skos:notation": "uncertainty",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Uncertainty assertion"
      },
      "skos:topConceptOf": {
        "@id": "chora:AssertionTypeScheme"
      }
    },
    {
      "@id": "chora:Validated",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "validata"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Validated by the project."
      },
      "skos:inScheme": {
        "@id": "chora:ReviewStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Validated"
      },
      "skos:topConceptOf": {
        "@id": "chora:ReviewStatusScheme"
      }
    },
    {
      "@id": "chora:VariantAssertion",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "variante"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Records a reading of another witness corresponding to an occurrence of the reference text."
      },
      "skos:inScheme": {
        "@id": "chora:AssertionTypeScheme"
      },
      "skos:notation": "variant",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Variant assertion"
      },
      "skos:topConceptOf": {
        "@id": "chora:AssertionTypeScheme"
      }
    },
    {
      "@id": "chora:ZoneOfAction",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Zona dell'Azione"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Several settings or projected spaces logically connected in the narrative by the scholar"
      },
      "skos:inScheme": {
        "@id": "chora:NarrativeRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Zone of Action"
      },
      "skos:topConceptOf": {
        "@id": "chora:NarrativeRoleScheme"
      }
    },
    {
      "@id": "chora:aboutSubject",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The resource the assertion is about (a narrative place, a place reference, a gazetteer entity, an interpretation)."
      },
      "rdfs:domain": {
        "@id": "chora:Assertion"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "riguarda"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "about subject"
      }
    },
    {
      "@id": "chora:adoptedByProject",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "True when the project adopts this reading (the one shown by the interface). It marks a choice, not a truth: the adopted reading is attributed like the others."
      },
      "rdfs:domain": {
        "@id": "chora:Assertion"
      },
      "rdfs:range": {
        "@id": "xsd:boolean"
      },
      "skos:altLabel": {
