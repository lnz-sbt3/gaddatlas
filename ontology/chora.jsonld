        "@value": "Testimone"
      },
      "skos:editorialNote": {
        "@language": "it",
        "@value": "Sottoclasse di frbr:Expression perche' il codominio di hico:isExtractedFrom lo impone: un testimone e' fonte di letture. Per i testimoni unici (dattiloscritto, bozze) e' un'approssimazione: sono piuttosto esemplari (FRBR Item, LRMoo F5) (D-067)."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Witness"
      }
    },
