      "rdfs:comment": {
        "@language": "en",
        "@value": "A witness of a literary work: a periodical redaction, a typescript, a set of proofs, a first edition or a later edition, each carrying a state of the text. Derivations between witnesses (prov:wasDerivedFrom) are stated only where documented."
      },
      "rdfs:subClassOf": [
        {
          "@id": "frbr:Expression"
        },
        {
          "@id": "prov:Entity"
