    {
      "@id": "chora:Above",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "dcterms:description": {
        "@language": "it",
        "@value": "A è verticalmente sopra B lungo l'asse gravitazionale."
      },
      "rdfs:comment": {
        "@language": "it",
        "@value": "Basato su Verticality in narratologia (Ryan 2001) e preposizioni cognitive (Talmy 2000)"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Sopra"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialRelationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Above"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialRelationTypeScheme"
      }
    },
    {
      "@id": "chora:AdjacentTo",
