    {
      "@id": "https://w3id.org/chora#PlaceReference",
      "@type": "owl:Class",
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "A PlaceReference does not “resolve” a referent nor determine the place type: disambiguation, classification, and any topographic anchoring are asserted at the level of SpatialInterpretation."
        },
        {
          "@language": "it",
          "@value": "PlaceReference non “risolve” il referente né determina il tipo di luogo: la disambiguazione, la classificazione e l’eventuale ancoraggio topografico sono esplicitati a livello di SpatialInterpretation."
        }
      ],
      "skos:definition": [
        {
          "@language": "en",
          "@value": "A textual occurrence in which the text mentions or evokes a spatial element; it is the basic evidential unit and includes bibliographic and contextual information (e.g., source, page, passage, quotation)."
        },
        {
          "@language": "it",
          "@value": "Occorrenza testuale in cui il testo menziona o richiama un elemento spaziale; costituisce l’unità attestativa di base e include informazioni bibliografiche e contestuali (es. fonte, pagina, segmento, citazione)."
        }
      ]
    },
