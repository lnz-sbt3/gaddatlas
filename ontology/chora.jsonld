    {
      "@id": "https://w3id.org/chora#SpatialDeterminationScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Spatial Determination"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Caratterizzazione spaziale"
      },
      "skos:hasTopConcept": [
        {
          "@id": "https://w3id.org/chora#Approximate"
        },
        {
          "@id": "https://w3id.org/chora#Indeterminate"
        },
        {
