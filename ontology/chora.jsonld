    {
      "@id": "https://w3id.org/chora",
      "@type": "owl:Ontology",
      "dc:creator": {
        "@id": "https://orcid.org/0009-0007-1496-722X"
      },
      "dc:description": {
        "@language": "en",
        "@value": "An ontology for modelling narrative spatiality in Carlo Emilio Gadda's \"Quer pasticciaccio brutto de via Merulana\", integrating place references, critical spatial interpretations, and geographic anchoring across a three-tier data model."
      },
      "dc:title": "GaddAtlas Ontology",
      "dcterms:bibliographicCitation": {
        "@language": "en",
        "@value": "[Sabatino, Lorenzo]. (2026). GaddAtlas Ontology. Università di Bologna."
      },
      "dcterms:contributor": [
        {
          "@id": "_:n76bdc3ddf41d4079b2bd2dc8641e1ceab1"
        },
        {
          "@id": "_:n76bdc3ddf41d4079b2bd2dc8641e1ceab2"
        }
      ],
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2025-10-01"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-08-11"
      },
      "dcterms:publisher": {
        "@id": "https://ror.org/01111rn36"
      },
      "owl:versionIRI": {
        "@id": "https://w3id.org/chora/4.1.1"
      },
      "owl:versionInfo": "4.1.1",
      "rdfs:comment": {
        "@language": "en",
        "@value": "GaddAtlas reuses terms from SKOS, PROV-O, GeoSPARQL, and Web Annotation without importing the complete ontologies, to maintain lightweight reasoning and avoid unintended inferences."
      },
      "rdfs:label": "GaddAtlas Ontology",
      "rdfs:seeAlso": [
        {
          "@id": "http://www.w3.org/2004/02/skos/core"
        },
        {
          "@id": "http://www.w3.org/ns/prov-o"
        },
        {
          "@id": "https://w3id.org/chora/vocab/placecategory"
        }
      ],
      "vann:preferredNamespacePrefix": "ga",
      "vann:preferredNamespaceUri": "https://w3id.org/chora#"
    },
    {
      "@id": "_:n76bdc3ddf41d4079b2bd2dc8641e1ceab1",
      "@type": "prov:Agent",
      "schema:name": "Francesca Tomasi"
    },
    {
      "@id": "_:n76bdc3ddf41d4079b2bd2dc8641e1ceab2",
      "@type": "prov:Agent",
      "schema:name": "Paola Maria Carmela Italia"
    },
    {
      "@id": "http://www.wikidata.org/entity/Q27686",
      "@type": "owl:NamedIndividual"
    },
    {
      "@id": "http://www.wikidata.org/entity/Q79007",
      "@type": "owl:NamedIndividual"
    },
    {
      "@id": "http://www.wikidata.org/entity/Q22667",
      "@type": "owl:NamedIndividual"
    },
    {
      "@id": "https://w3id.org/chora#GazetteerEntity",
      "@type": "owl:Class",
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "GazetteerEntity does not belong to the world of the text: it models the external topographic counterpart. The relation to a NarrativePlace is not assumed as identity but as a typed anchoring, asserted by SpatialInterpretation."
        },
        {
          "@language": "it",
          "@value": "GazetteerEntity non appartiene al mondo del testo: modella la controparte topografica esterna. La relazione con NarrativePlace non è assunta come identità, ma come ancoraggio tipizzato, espresso da SpatialInterpretation."
        }
      ],
      "skos:definition": [
        {
          "@language": "en",
          "@value": "An extra-textual georeferenceable place described as an authority/gazetteer entity, typically endowed with stable geometry (coordinates or GeoJSON) and persistent identifiers; it provides the external topographic referent to which narrative places may be anchored."
        },
        {
          "@language": "it",
          "@value": "Luogo extra-testuale georeferenziabile, descritto come entità di authority/gazetteer e tipicamente dotato di geometria stabile (coordinate o GeoJSON) e identificatori persistenti; costituisce il referente topografico esterno a cui possono essere ancorati i luoghi narrativi."
        }
      ]
    },
    {
      "@id": "https://w3id.org/chora#interpretsReference",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a spatial interpretation to the specific textual place reference it interprets"
      },
      "rdfs:domain": {
        "@id": "https://w3id.org/chora#SpatialInterpretation"
      },
      "rdfs:range": {
        "@id": "https://w3id.org/chora#PlaceReference"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "interpreta il riferimento"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "interprets reference"
      }
    },
    {
      "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#lat",
