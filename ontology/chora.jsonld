      "@id": "chora:ReadingAuthor",
      "@type": [
        "owl:NamedIndividual",
        "prov:Role",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "autore della lettura"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The agent who formulated the reading: a scholar, or the project when the reading is its own."
      },
      "skos:inScheme": {
        "@id": "chora:AttributionRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Reading author"
      },
      "skos:topConceptOf": {
        "@id": "chora:AttributionRoleScheme"
      }
    },
    {
      "@id": "chora:RealityStatusScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Reality Status"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Stato di Realtà"
      },
      "skos:hasTopConcept": [
        {
          "@id": "chora:Imagined"
        },
