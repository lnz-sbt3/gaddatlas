        "@language": "it",
        "@value": "curatore"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "editor"
      }
    },
    {
      "@id": "chora:evidenceSource",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Records textual or critical evidence supporting a spatial interpretation."
      },
      "rdfs:domain": {
        "@id": "chora:SpatialInterpretation"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "fonte dell evidenza"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "evidence source"
      }
    },
    {
      "@id": "chora:excerpt",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": {
        "@id": "chora:PlaceReference"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "estratto"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "excerpt"
      }
    },
    {
      "@id": "chora:groundedIn",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The occurrences of the text on which a reading rests. Stated explicitly (Grounded_In) or, by default, all the reference-witness occurrences interpreted on the subject place, anchored to the subject entity, or carrying the subject route (D-070)."
      },
      "rdfs:domain": {
        "@id": "chora:Assertion"
      },
      "rdfs:range": {
        "@id": "chora:PlaceReference"
      },
      "rdfs:subPropertyOf": {
        "@id": "cito:citesAsEvidence"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "si fonda su"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "grounded in"
      }
    },
    {
      "@id": "chora:hasFocalizer",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "it",
        "@value": "Collega una SpatialInterpretation all'agente attraverso cui lo spazio è percepito; la coppia luogo×focalizzatore è l'unità base del dataset."
      },
      "rdfs:domain": {
        "@id": "chora:SpatialInterpretation"
      },
      "rdfs:range": {
        "@id": "chora:FocalizingAgent"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha focalizzatore"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has focalizer"
      }
    },
    {
      "@id": "chora:hasFuzzinessLevel",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Encodes the degree of spatial determination (i.e., how approximate or blurred the place's location is), as an invariant property of the place itself."
      },
      "rdfs:domain": {
        "@id": "chora:NarrativePlace"
      },
      "rdfs:range": {
        "@id": "xsd:decimal"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha livello di sfocatura"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has fuzziness level"
      }
    },
    {
      "@id": "chora:hasGender",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": {
        "@id": "chora:FocalizingAgent"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha genere"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has gender"
      }
    },
    {
      "@id": "chora:hasInterpretation",
      "@type": "owl:ObjectProperty",
      "owl:inverseOf": {
        "@id": "chora:interpretsReference"
      },
      "rdfs:domain": {
        "@id": "chora:PlaceReference"
      },
      "rdfs:range": {
        "@id": "chora:SpatialInterpretation"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has interpretation"
      }
    },
    {
      "@id": "chora:hasNarratingVoice",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The voice that utters the passage of a spatial interpretation (who speaks), distinct from the focalizer (who perceives). Annotated only where a critical source discusses it; an interpretation without this property is «not annotated», which does not mean that voice and focalizer coincide."
      },
      "rdfs:domain": {
        "@id": "chora:SpatialInterpretation"
      },
      "rdfs:range": {
        "@id": "chora:FocalizingAgent"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha voce narrante"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has narrating voice"
      }
    },
    {
      "@id": "chora:hasPlaceCategory",
      "@type": "owl:ObjectProperty",
      "dcterms:references": {
        "@id": "chora:PlaceCategoryScheme"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Assigns a place category from a controlled vocabulary to any narrative place (discrete or vague)."
      },
      "rdfs:domain": {
        "@id": "chora:NarrativePlace"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "categoria di luogo"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has place category"
      }
    },
    {
      "@id": "chora:hasRealityStatus",
      "@type": "owl:ObjectProperty",
      "dcterms:references": {
        "@id": "chora:RealityStatusScheme"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Assigns the reality–fiction status of a narrative place, on a scale ordered from the concrete to the abstract: imported, transformed, invented, imagined (skos:notation 1–4; Reuschel, Piatti and Hurni 2013, pp. 138–139). This is an invariant property of the place as an authorial transposition of the real world into the text, NOT dependent on focalizer or interpretation."
      },
      "rdfs:domain": {
        "@id": "chora:NarrativePlace"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha stato di realtà"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has reality status"
      }
    },
    {
      "@id": "chora:hasRelationalAnchoring",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "chora:SpatialInterpretation"
      },
      "rdfs:range": {
        "@id": "chora:RelationalAnchoring"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha ancoraggio relazionale"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has relational anchoring"
      }
    },
    {
      "@id": "chora:hasRouteType",
      "@type": "owl:ObjectProperty",
      "dcterms:references": {
        "@id": "chora:RouteTypeScheme"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Type of a route, derived from the adopted route type assertion."
      },
      "rdfs:domain": {
        "@id": "chora:NarrativeRoute"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha tipo di percorso"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has route type"
      }
    },
    {
      "@id": "chora:hasSpatialGeometry",
      "@type": "owl:ObjectProperty",
      "rdfs:range": {
        "@id": "geo:Geometry"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha geometria spaziale"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has spatial geometry"
      }
    },
    {
      "@id": "chora:hasUncertaintyType",
      "@type": "owl:ObjectProperty",
      "dcterms:references": {
        "@id": "chora:UncertaintyTypeScheme"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Type of uncertainty of an occurrence (name axis), a narrative place (identification axis) or a gazetteer entity (geometry axis)."
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha tipo d'incertezza"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has uncertainty type"
      }
    },
    {
      "@id": "chora:hasVariant",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links an occurrence of the reference witness to the corresponding occurrence of another witness (variant reading)."
      },
      "rdfs:domain": {
        "@id": "chora:PlaceReference"
      },
      "rdfs:range": {
        "@id": "chora:PlaceReference"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha variante"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has variant"
      }
    },
    {
      "@id": "chora:hasZone",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a partition to one of its zones."
      },
      "rdfs:domain": {
        "@id": "chora:Partition"
      },
      "rdfs:range": {
        "@id": "chora:PartitionZone"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha zona"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "has zone"
      }
    },
    {
      "@id": "chora:heldAt",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Institution and fonds holding an unpublished witness."
      },
      "rdfs:domain": {
        "@id": "chora:Witness"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "conservato presso"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "held at"
      }
    },
    {
      "@id": "chora:historicalLocation",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Describes the historical location or historical-toponymic context of a gazetteer entity."
      },
      "rdfs:domain": {
        "@id": "chora:GazetteerEntity"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "localizzazione storica"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "historical location"
      }
    },
    {
      "@id": "chora:housedIn",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "An institution (e.g. a police station, a prison) is housed in a site (a building, a street). The two gazetteer entities are distinct referents: this is neither an identity (owl:sameAs) nor an identification assertion, and it never merges them."
        },
        {
          "@language": "it",
          "@value": "Un'istituzione (un commissariato, un carcere) ha sede in un luogo (un edificio, una via). Le due entita' del gazetteer sono referenti distinti: non e' un'identita' (owl:sameAs) ne' un'asserzione d'identificazione, e non le fonde."
        }
      ],
      "rdfs:domain": {
        "@id": "chora:GazetteerEntity"
      },
      "rdfs:range": {
        "@id": "chora:GazetteerEntity"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "ha sede in"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "housed in"
      }
    },
    {
      "@id": "chora:identifiedWith",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The geographic entity of the adopted identification of a narrative place; materialized by the ETL from the adopted IdentificationAssertion."
      },
      "rdfs:domain": {
        "@id": "chora:NarrativePlace"
      },
      "rdfs:range": {
        "@id": "chora:GazetteerEntity"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "identificato con"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "identified with"
      }
    },
    {
      "@id": "chora:inPartitionZone",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Assigns a narrative place to a zone of a partition. The assignment holds within the partition hypothesis that owns the zone; a place not assigned to any zone is not classified by that hypothesis."
      },
      "rdfs:domain": {
        "@id": "chora:NarrativePlace"
      },
      "rdfs:range": {
        "@id": "chora:PartitionZone"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "in zona"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "in partition zone"
      }
    },
    {
      "@id": "chora:interpretationType",
      "@type": "owl:DatatypeProperty",
      "owl:deprecated": true,
      "rdfs:comment": {
        "@language": "en",
        "@value": "Classifies the kind of spatial interpretation asserted by the annotation."
      },
      "rdfs:domain": {
        "@id": "chora:SpatialInterpretation"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "tipo di interpretazione"
      },
      "skos:historyNote": {
        "@language": "it",
        "@value": "Deprecata il 9/10/2026 (D-042): il tipo di una lettura e' chora:assertionType su chora:Assertion."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "interpretation type"
      }
    },
    {
      "@id": "chora:interpretsReference",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a spatial interpretation to the specific textual place reference it interprets"
      },
      "rdfs:domain": {
        "@id": "chora:SpatialInterpretation"
      },
      "rdfs:range": {
        "@id": "chora:PlaceReference"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "interpreta il riferimento"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "interprets reference"
      }
    },
    {
      "@id": "chora:isNodeOfRoute",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Declares that a spatial interpretation is a node (stop) of a narrative route. The node's place is reached via targetsPlace; its position via routeOrder; its focalizer via hasFocalizer. The route of a node and the node share the same focalizer."
      },
      "rdfs:domain": {
        "@id": "chora:SpatialInterpretation"
      },
      "rdfs:range": {
        "@id": "chora:NarrativeRoute"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "è nodo del tragitto"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "is node of route"
      }
    },
    {
      "@id": "chora:isPartOf",
      "@type": [
        "owl:ObjectProperty",
        "owl:TransitiveProperty"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "Meronymic relation between narrative places: the subject place is a structural component of the object place (e.g. a staircase of a building). Invariant with respect to focalizer. A place with isPartOf inherits its geographic anchoring from the parent and should NOT carry its own anchorsToEntity."
      },
      "rdfs:domain": {
        "@id": "chora:NarrativePlace"
      },
      "rdfs:range": {
        "@id": "chora:NarrativePlace"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "è parte di"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "is part of"
      }
    },
    {
      "@id": "chora:localizationReason",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Motivation of a suspended localization."
      },
      "rdfs:domain": {
        "@id": "chora:NarrativePlace"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "motivo della sospensione"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "localization reason"
      }
    },
    {
      "@id": "chora:localizationStatus",
      "@type": "owl:ObjectProperty",
      "dcterms:references": {
        "@id": "chora:LocalizationStatusScheme"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Why a narrative place has no geographic anchoring. It is distinct from missing data: a place without anchoring and without this status is an error (integrity query IQ14)."
      },
      "rdfs:domain": {
        "@id": "chora:NarrativePlace"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "stato di localizzazione"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "localization status"
      }
    },
    {
      "@id": "chora:memoryAttribution",
      "@type": "owl:ObjectProperty",
      "dcterms:references": {
        "@id": "chora:MemoryAttributionScheme"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Whose memory a remembered space belongs to, for an occurrence."
      },
      "rdfs:domain": {
        "@id": "chora:PlaceReference"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "attribuzione della memoria"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "memory attribution"
      }
    },
    {
      "@id": "chora:mentionedInChapter",
