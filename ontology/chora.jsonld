      },
      "rdfs:range": {
        "@id": "xsd:decimal"
      }
    },
    {
      "@id": "chora:criticalNote",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Stores an interpretive or editorial note attached to a spatial interpretation."
      },
      "rdfs:domain": {
        "@id": "chora:SpatialInterpretation"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "nota critica"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "critical note"
      }
    },
    {
      "@id": "chora:datum",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Datum of the repertory, when different from WGS84, with the stated shift."
      },
      "rdfs:domain": {
        "@id": "geo:Geometry"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "datum"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "datum"
      }
    },
    {
      "@id": "chora:editor",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Editor(s) of an edition («a cura di»)."
      },
      "rdfs:domain": {
        "@id": "chora:Witness"
      },
      "rdfs:subPropertyOf": {
        "@id": "dcterms:contributor"
