          "@id": "chora:Imported"
        },
        {
          "@id": "chora:Invented"
        },
        {
          "@id": "chora:Transformed"
        }
      ],
      "skos:historyNote": {
        "@language": "it",
        "@value": "Fino all'8/10/2026 le etichette Invented e Imagined erano invertite rispetto alle definizioni (D-030). Lo scambio e' una correzione dello schema, non una revisione delle letture: non genera prov:wasRevisionOf (D-051)."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Reality Status"
      }
    },
    {
      "@id": "chora:ReferentialEvidence",
      "@type": [
        "hico:InterpretationCriterion",
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "prova referenziale"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The reading rests on a repertory (map, guide, gazetteer) that documents or excludes the referent."
      },
      "skos:inScheme": {
        "@id": "chora:RationaleTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Referential evidence"
      },
      "skos:topConceptOf": {
        "@id": "chora:RationaleTypeScheme"
      }
    },
    {
      "@id": "chora:RelatedTo",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "dcterms:description": {
        "@language": "it",
        "@value": "Relazione spaziale generica tra A e B, non ulteriormente specificata sul piano topologico."
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "In relazione con"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialRelationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Related to"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialRelationTypeScheme"
      }
    },
    {
      "@id": "chora:RelationalAnchoring",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "How a passage places a narrative place relative to one or more geographic entities («between», «near», «adjacent to»). The relata qualify the anchors of the place, they do not replace them: when the interpretation has no direct anchor, the gazetteer relata are its anchors, and the place is positioned from them (D-084). No annotated place is left out of the interface."
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Ancoraggio relazionale"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Relational anchoring"
      }
    },
    {
      "@id": "chora:Relative",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Relativa"
      },
      "skos:inScheme": {
        "@id": "chora:SpatialDeterminationScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Relative"
      },
      "skos:topConceptOf": {
        "@id": "chora:SpatialDeterminationScheme"
      }
    },
    {
      "@id": "chora:ReviewStatusScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Review status"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Stato di revisione"
      },
      "skos:hasTopConcept": [
        {
          "@id": "chora:Draft"
        },
        {
          "@id": "chora:Validated"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Review status"
      }
    },
    {
      "@id": "chora:Route",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Percorso"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Path along which characters move, connecting multiple settings or projected spaces"
      },
      "skos:inScheme": {
        "@id": "chora:NarrativeRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Route"
      },
      "skos:topConceptOf": {
        "@id": "chora:NarrativeRoleScheme"
      }
    },
    {
      "@id": "chora:RouteTypeAssertion",
      "@type": [
        "hico:InterpretationType",
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "chora:reifiesProperty": {
        "@id": "chora:hasRouteType"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "tipo di percorso"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Assigns a route type to a narrative route."
      },
      "skos:inScheme": {
        "@id": "chora:AssertionTypeScheme"
      },
      "skos:notation": "route",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Route type assertion"
      },
      "skos:topConceptOf": {
        "@id": "chora:AssertionTypeScheme"
      }
    },
    {
      "@id": "chora:RouteTypeScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Route type"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Tipo di percorso"
      },
      "skos:hasTopConcept": [
        {
          "@id": "chora:CompletedRoute"
        },
        {
          "@id": "chora:DirectionalRoute"
        },
        {
          "@id": "chora:DreamedRoute"
        },
        {
          "@id": "chora:IndicatedRoute"
        },
        {
          "@id": "chora:InferredRoute"
        },
        {
          "@id": "chora:ProposedRoute"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Route type"
      }
    },
    {
      "@id": "chora:Scholar",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A scholar whose readings are encoded in the dataset as attributed assertions (D-062)."
      },
      "rdfs:subClassOf": {
        "@id": "prov:Person"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Studioso"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Scholar"
      }
    },
    {
      "@id": "chora:Setting",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "it",
        "@value": "Ambientazione"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Place where the action occurs, with characters physically present"
      },
      "skos:inScheme": {
        "@id": "chora:NarrativeRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Setting"
      },
      "skos:topConceptOf": {
        "@id": "chora:NarrativeRoleScheme"
      }
    },
    {
      "@id": "chora:Source",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A bibliographic source of readings: a scholarly work, the thesis, the project census, a dated map or repertory (Sources.tsv)."
      },
      "rdfs:subClassOf": {
        "@id": "frbr:Expression"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Fonte"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Source"
      }
    },
    {
      "@id": "chora:SpatialDeterminationScheme",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Spatial Determination"
      },
      "skos:altLabel": {
        "@language": "it",
        "@value": "Caratterizzazione spaziale"
      },
      "skos:hasTopConcept": [
        {
          "@id": "chora:Approximate"
        },
        {
          "@id": "chora:Indeterminate"
        },
        {
          "@id": "chora:Precise"
        },
        {
          "@id": "chora:Relative"
        }
      ],
      "skos:prefLabel": {
