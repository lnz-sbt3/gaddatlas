<http://vocab.getty.edu/aat/300386699> a owl:NamedIndividual .

geo:asGeoJSON a owl:DatatypeProperty ;
    rdfs:domain geo:Geometry ;
    rdfs:range rdfs:Literal .

geo:hasGeometry a owl:ObjectProperty ;
    rdfs:domain chora:GazetteerEntity ;
    rdfs:range geo:Geometry ;
    rdfs:subPropertyOf chora:hasSpatialGeometry ;
    skos:prefLabel "has geometry"@en .

xsd:date a rdfs:Datatype .

<http://www.w3.org/2003/01/geo/wgs84_pos#lat> a owl:DatatypeProperty ;
    rdfs:domain chora:GazetteerEntity ;
    rdfs:range xsd:decimal ;
    skos:altLabel "latitudine"@it ;
    skos:prefLabel "latitude"@en .

<http://www.w3.org/2003/01/geo/wgs84_pos#long> a owl:DatatypeProperty ;
    rdfs:domain chora:GazetteerEntity ;
    rdfs:range xsd:decimal ;
    skos:altLabel "longitudine"@it ;
    skos:prefLabel "longitude"@en .

skos:altLabel a owl:AnnotationProperty .

skos:broadMatch a owl:AnnotationProperty .

skos:closeMatch a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

skos:hasTopConcept a owl:AnnotationProperty .

skos:inScheme a owl:AnnotationProperty .

skos:narrowMatch a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .

skos:topConceptOf a owl:AnnotationProperty .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> .

