# =============================================================================
# gaddatlas_shapes.ttl  —  Shape SHACL per la validazione del grafo GaddAtlas
# =============================================================================
#
# COME LEGGERE QUESTO FILE (guida rapida a SHACL)
# -----------------------------------------------------------------------------
# Una "shape" (sh:NodeShape) descrive come devono essere fatti i nodi di una
# certa classe. La struttura è sempre:
#
#   <NomeShape> a sh:NodeShape ;
#       sh:targetClass <ClasseDaControllare> ;   # A QUALI nodi si applica
#       sh:property [ ... ] ;                     # UN vincolo su una proprietà
#       sh:property [ ... ] .                     # un altro vincolo
#
# Dentro ogni sh:property:
#   sh:path        = quale proprietà controllo (es. ga:hasFocalizer)
#   sh:minCount N  = deve comparire almeno N volte
#   sh:maxCount N  = al massimo N volte
#   sh:class C     = il valore deve essere un individuo di classe C
#   sh:in ( ... )  = il valore deve essere UNO di questa lista chiusa
#   sh:datatype    = il valore letterale deve essere di questo tipo
#   sh:message     = cosa leggerai nel report se il vincolo è violato
#   sh:severity    = sh:Violation (errore) | sh:Warning | sh:Info
#
# Il validatore (pySHACL) confronta questo file con i dati e produce un
# "validation report": sh:conforms true/false + elenco delle violazioni.
# =============================================================================

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ga:   <https://w3id.org/chora#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .


# =============================================================================
# SHAPE 1 — SpatialInterpretation
# L'unità base del dataset: la coppia (luogo × focalizzatore).
# Invarianti: esattamente 1 focalizzatore; esattamente 1 target (place o route);
# al massimo 1 valore per ciascun assigns*; vocabolari controllati.
# =============================================================================

ga:SpatialInterpretationShape
    a sh:NodeShape ;
    sh:targetClass ga:SpatialInterpretation ;

    # --- Focalizzatore: esattamente uno. È l'invariante centrale del modello. ---
    sh:property [
        sh:path ga:hasFocalizer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ga:FocalizingAgent ;
        sh:message "Ogni SpatialInterpretation deve avere esattamente un focalizzatore (FocalizingAgent)." ;
        sh:severity sh:Violation ;
    ] ;

    # --- Deve interpretare esattamente una PlaceReference ---
    sh:property [
        sh:path ga:interpretsReference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ga:PlaceReference ;
        sh:message "Ogni SpatialInterpretation deve interpretare esattamente una PlaceReference." ;
        sh:severity sh:Violation ;
    ] ;

    # --- Narrative role: al massimo uno, dai 5 valori ammessi ---
    sh:property [
        sh:path ga:assignsNarrativeRole ;
        sh:maxCount 1 ;
        sh:in ( ga:Marker ga:Setting ga:ProjectedSpace ga:Route ga:ZoneOfAction ) ;
        sh:message "assignsNarrativeRole deve essere uno dei 5 valori del vocabolario NarrativeRole" ;
        sh:severity sh:Violation ;
    ] ;

    # --- Spatial determination: al massimo uno, dai 4 valori ammessi ---
    sh:property [
        sh:path ga:assignsSpatialDetermination ;
        sh:maxCount 1 ;
        sh:in ( ga:Precise ga:Approximate ga:Relative ga:Indeterminate ) ;
        sh:message "assignsSpatialDetermination deve essere uno dei 4 valori del vocabolario SpatialDetermination." ;
        sh:severity sh:Violation ;
    ] ;

    # --- Spatial relation type: al massimo uno, dai valori topologici ammessi ---
    # (direct/null NON sono qui: sono assenza di relazione, quindi assenza di tripla)
    sh:property [
        sh:path ga:assignsSpatialRelationType ;
        sh:maxCount 1 ;
        sh:in ( ga:Inside ga:Contains ga:Near ga:AdjacentTo ga:Above ga:Below ga:Overlaps ga:RelatedTo ga:Between
                ga:Threshold ga:Facing ga:Boundary ) ;
        sh:message "assignsSpatialRelationType, se presente, deve essere un valore del vocabolario SpatialRelationType." ;
        sh:severity sh:Violation ;
    ] ;

    # --- anchorsToEntity: se presente, DEVE puntare a un GazetteerEntity ---
    # Cattura formalmente la regola "i generatori sono ancorati a entità geografiche".
    sh:property [
        sh:path ga:anchorsToEntity ;
        sh:class ga:GazetteerEntity ;
        sh:message "anchorsToEntity deve puntare a un GazetteerEntity, mai a un NarrativePlace." ;
        sh:severity sh:Violation ;
    ] ;

    # --- TARGETING: esattamente un bersaglio, place XOR route ---
    # sh:xone impone che valga UNA sola delle due
    # alternative: o targetsPlace (1 valore, verso NarrativePlace) oppure
    # targetsRoute (1 valore, verso NarrativeRoute), mai entrambe, mai
    # nessuna delle due.
    sh:xone (
        [
            sh:property [
                sh:path ga:targetsPlace ;
                sh:minCount 1 ; sh:maxCount 1 ;
                sh:class ga:NarrativePlace ;
            ] ;
            sh:property [ sh:path ga:targetsRoute ; sh:maxCount 0 ; ] ;
        ]
        [
            sh:property [
                sh:path ga:targetsRoute ;
                sh:minCount 1 ; sh:maxCount 1 ;
                sh:class ga:NarrativeRoute ;
            ] ;
            sh:property [ sh:path ga:targetsPlace ; sh:maxCount 0 ; ] ;
        ]
    ) ;
    sh:message "Ogni SpatialInterpretation deve avere esattamente un bersaglio: o un ga:NarrativePlace via targetsPlace, o una ga:NarrativeRoute via targetsRoute, mai entrambi ne' nessuno." ;
    sh:severity sh:Violation ;

    # --- confidence: se presente, un decimal tra 0 e 1 ---
    sh:property [
        sh:path ga:confidence ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "confidence deve essere un decimale tra 0 e 1." ;
        sh:severity sh:Warning ;
    ] .


# =============================================================================
# SHAPE 2 — Nodi di percorso (Route nodes)
# Chi ha isNodeOfRoute DEVE avere anche routeOrder, e viceversa.
# Si applica alle SpatialInterpretation che sono nodi di un tragitto.
# =============================================================================

ga:RouteNodeShape
    a sh:NodeShape ;
    # target: i nodi sono i soggetti che hanno isNodeOfRoute.
    # Usiamo sh:targetSubjectsOf per agganciare "chi possiede questa proprietà".
    sh:targetSubjectsOf ga:isNodeOfRoute ;

    sh:property [
        sh:path ga:isNodeOfRoute ;
        sh:minCount 1 ;
        sh:class ga:NarrativeRoute ;
        sh:message "isNodeOfRoute deve puntare a una NarrativeRoute." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path ga:routeOrder ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "Un nodo di percorso (isNodeOfRoute) deve avere esattamente un routeOrder intero >= 1." ;
        sh:severity sh:Violation ;
    ] .


# =============================================================================
# SHAPE 3 — NarrativePlace
# RealityStatus è invariante del luogo: al massimo uno, dai 4 valori ammessi.
# isPartOf, se presente, deve puntare a un altro NarrativePlace.
# =============================================================================

ga:NarrativePlaceShape
    a sh:NodeShape ;
    sh:targetClass ga:NarrativePlace ;

    # --- RealityStatus: al massimo uno (invariante per luogo), dai 4 valori ---
    sh:property [
        sh:path ga:hasRealityStatus ;
        sh:maxCount 1 ;
        sh:in ( ga:Imported ga:Transformed ga:Invented ga:Imagined ) ;
        sh:message "hasRealityStatus deve essere uno dei 4 valori ammessi, al massimo uno per luogo (invariante)." ;
        sh:severity sh:Violation ;
    ] ;

    # --- isPartOf: se presente, punta a un NarrativePlace ---
    sh:property [
        sh:path ga:isPartOf ;
        sh:class ga:NarrativePlace ;
        sh:message "isPartOf deve puntare a un altro NarrativePlace." ;
        sh:severity sh:Violation ;
    ] ;

    # --- hasPlaceCategory: al massimo uno ---
    sh:property [
        sh:path ga:hasPlaceCategory ;
        sh:maxCount 1 ;
        sh:message "Un luogo dovrebbe avere al massimo una categoria." ;
        sh:severity sh:Warning ;
    ] ;

    # --- fuzziness: se presente, decimal ---
    sh:property [
        sh:path ga:hasFuzzinessLevel ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "hasFuzzinessLevel deve essere un decimale singolo." ;
        sh:severity sh:Warning ;
    ] .


# =============================================================================
# SHAPE 4 — NarrativeRoute
# Un tragitto deve essere il bersaglio di almeno un targetsRoute
# (cioè almeno un'interpretazione lo attiva).
# =============================================================================

ga:NarrativeRouteShape
    a sh:NodeShape ;
    sh:targetClass ga:NarrativeRoute ;
    sh:property [
        sh:path [ sh:inversePath ga:targetsRoute ] ;
        sh:minCount 1 ;
        sh:message "Una NarrativeRoute deve essere bersaglio di almeno un targetsRoute (nessun tragitto orfano)." ;
        sh:severity sh:Warning ;
    ] .


# =============================================================================
# SHAPE 5 — PlaceReference
# Ogni attestazione testuale deve avere l'excerpt, la fonte, l'opera e il capitolo.
# =============================================================================

ga:PlaceReferenceShape
    a sh:NodeShape ;
    sh:targetClass ga:PlaceReference ;
    sh:property [
        sh:path ga:appearsInWork ;
        sh:minCount 1 ;
        sh:class ga:LiteraryWork ;
        sh:message "Ogni PlaceReference deve appartenere a una LiteraryWork." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path ga:appearsInWitness ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class ga:Witness ;
        sh:message "Ogni PlaceReference compare in uno e un solo testimone (D-055)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path ga:excerpt ;
        sh:minCount 1 ;
        sh:message "Ogni PlaceReference deve avere un excerpt testuale." ;
        sh:severity sh:Warning ;
    ] .


# =============================================================================
# SHAPE 6 — GazetteerEntity
# Un'entità geografica dovrebbe avere coordinate (lat/long) o una geometria.
# Warning, non Violation: alcune entità potrebbero essere non georeferenziabili.
# =============================================================================

ga:GazetteerEntityShape
    a sh:NodeShape ;
    sh:targetClass ga:GazetteerEntity ;
    sh:property [
        sh:path ga:lat ;
        sh:maxCount 1 ;
        sh:message "lat, se presente, deve essere singola." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path ga:long ;
        sh:maxCount 1 ;
        sh:message "long, se presente, deve essere singola." ;
        sh:severity sh:Warning ;
    ] .


# =============================================================================
# SHAPE 7 — Assertion (D-042, work order T-30)
# Una lettura attribuita: tipo, soggetto, valore; almeno un autore della
# lettura e almeno un codificatore (prov:qualifiedAttribution con prov:hadRole);
# la forma breve prov:wasAttributedTo verso l'autore, generata dall'ETL;
# al piu' un flag di adozione. La regola «una sola lettura adottata per
# soggetto e tipo» sta in integrity.rq (IQ12).
# =============================================================================

ga:AssertionShape
    a sh:NodeShape ;
    sh:targetClass ga:Assertion ;
    sh:property [
        sh:path ga:assertionType ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( ga:StatusAssertion ga:IdentificationAssertion ga:LocationAssertion
                ga:PartitionAssertion ga:MemoryAssertion ga:UncertaintyAssertion
                ga:VariantAssertion ga:RouteTypeAssertion ) ;
        sh:message "Ogni Assertion ha esattamente un tipo dello schema AssertionType." ;
    ] ;
    sh:property [
        sh:path ga:aboutSubject ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Ogni Assertion riguarda esattamente un soggetto." ;
    ] ;
    sh:property [
        sh:path ga:assertsValue ;
        sh:minCount 1 ;
        sh:message "Ogni Assertion assegna almeno un valore." ;
    ] ;
    sh:property [
        sh:path ga:adoptedByProject ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "adoptedByProject, se presente, e' un booleano singolo." ;
    ] ;
    sh:property [
        sh:path prov:wasAttributedTo ;
        sh:minCount 1 ;
        sh:message "Ogni Assertion porta la forma breve prov:wasAttributedTo verso l'autore della lettura." ;
    ] .

# Attribuzioni qualificate: almeno un autore della lettura e almeno un
# codificatore, per le asserzioni e per le interpretazioni (D-043).
ga:QualifiedAttributionShape
    a sh:NodeShape ;
    sh:targetClass ga:Assertion, ga:SpatialInterpretation ;
    sh:property [
        sh:path prov:qualifiedAttribution ;
        sh:qualifiedValueShape [ sh:path prov:hadRole ; sh:hasValue ga:ReadingAuthor ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Manca un'attribuzione con ruolo chora:ReadingAuthor (autore della lettura)." ;
    ] ;
    sh:property [
        sh:path prov:qualifiedAttribution ;
        sh:qualifiedValueShape [ sh:path prov:hadRole ; sh:hasValue ga:Encoder ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Manca un'attribuzione con ruolo chora:Encoder (codificatore)." ;
    ] .

ga:AttributionShape
    a sh:NodeShape ;
    sh:targetObjectsOf prov:qualifiedAttribution ;
    sh:property [
        sh:path prov:agent ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class prov:Agent ;
        sh:message "Ogni attribuzione ha esattamente un agente, tipizzato prov:Agent." ;
    ] ;
    sh:property [
        sh:path prov:hadRole ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( ga:ReadingAuthor ga:Encoder ) ;
        sh:message "Ogni attribuzione ha esattamente un ruolo: ReadingAuthor o Encoder." ;
    ] .


# =============================================================================
# SHAPE 8 — Motivazione dello statuto (D-046, work order T-33)
# Ogni luogo non Imported e' soggetto di un'asserzione di statuto adottata, con
# motivazione, tipo di motivazione e stato «validata». Gli Imported hanno la
# motivazione standard (scopeNote di chora:Imported). sh:Warning finche' le
# bozze non sono validate; diventa sh:Violation prima della consegna.
# =============================================================================

ga:StatusRationaleShape
    a sh:NodeShape ;
    sh:targetClass ga:NarrativePlace ;
    sh:severity sh:Warning ;
    sh:message "Luogo non Imported senza un'asserzione di statuto adottata, motivata e validata (T-33)." ;
    sh:or (
        [ sh:path ga:hasRealityStatus ; sh:hasValue ga:Imported ]
        [ sh:path [ sh:inversePath ga:aboutSubject ] ;
          sh:qualifiedValueShape [
              sh:and (
                  [ sh:path ga:assertionType ; sh:hasValue ga:StatusAssertion ]
                  [ sh:path ga:adoptedByProject ; sh:hasValue true ]
                  [ sh:path ga:rationale ; sh:minCount 1 ]
                  [ sh:path ga:rationaleType ; sh:minCount 1 ]
                  [ sh:path ga:reviewStatus ; sh:hasValue ga:Validated ]
              )
          ] ;
          sh:qualifiedMinCount 1 ]
    ) .


# =============================================================================
# SHAPE 9 — Incertezza (D-047, work order T-34)
# Un'asserzione d'incertezza ha un tipo dello schema UncertaintyType, un asse e
# un'origine.
# =============================================================================

ga:UncertaintyAssertionShape
    a sh:NodeShape ;
    sh:targetClass ga:Assertion ;
    sh:or (
        [ sh:not [ sh:path ga:assertionType ; sh:hasValue ga:UncertaintyAssertion ] ]
        [ sh:and (
            [ sh:path ga:uncertaintyAxis ; sh:minCount 1 ; sh:maxCount 1 ;
              sh:in ( ga:NameAxis ga:IdentificationAxis ga:GeometryAxis ) ]
            [ sh:path ga:uncertaintyOrigin ; sh:minCount 1 ; sh:maxCount 1 ;
              sh:in ( ga:DocumentaryOrigin ga:ConstructiveOrigin ) ]
            [ sh:path ga:assertsValue ; sh:minCount 1 ;
              sh:in ( ga:Vagueness ga:NonSpecificity ga:ContestedIdentification ga:Discrepancy
                      ga:Oversight ga:Anachronism ga:Confusion ga:InternalDiscrepancy
                      ga:Incompleteness ga:NonApplicability ) ]
          ) ]
    ) ;
    sh:message "Un'asserzione d'incertezza ha un tipo dello schema UncertaintyType, un asse e un'origine." .


# =============================================================================
# SHAPE 10 — Astensione dall'ancoraggio (D-048, work order T-35)
# Valori ammessi; la sospensione motivata richiede il motivo. La regola «un
# luogo senza ancoraggio dichiara uno stato» sta in integrity.rq (IQ14), perche'
# l'ancoraggio puo' essere ereditato (isPartOf) o venire da una lettura adottata.
# =============================================================================

ga:LocalizationStatusShape
    a sh:NodeShape ;
    sh:targetClass ga:NarrativePlace ;
    sh:property [
        sh:path ga:localizationStatus ;
        sh:maxCount 1 ;
        sh:in ( ga:NotYetAnalysed ga:SuspendedWithReason ga:NotApplicable ) ;
        sh:message "localizationStatus: al piu' un valore dello schema LocalizationStatus." ;
    ] ;
    sh:or (
        [ sh:not [ sh:path ga:localizationStatus ; sh:hasValue ga:SuspendedWithReason ] ]
        [ sh:path ga:localizationReason ; sh:minCount 1 ]
    ) ;
    sh:message "Una sospensione motivata dell'ancoraggio richiede chora:localizationReason." .


# =============================================================================
# SHAPE 11 — Livelli enunciativi (D-049, work order T-36)
# La voce narrante e' facoltativa: la sua assenza vale «non annotato».
# Un'asserzione di memoria usa i valori dello schema MemoryAttribution.
# =============================================================================

ga:NarratingVoiceShape
    a sh:NodeShape ;
    sh:targetClass ga:SpatialInterpretation ;
    sh:property [
        sh:path ga:hasNarratingVoice ;
        sh:maxCount 1 ;
        sh:class ga:FocalizingAgent ;
        sh:message "hasNarratingVoice: al piu' una voce, che sia un FocalizingAgent." ;
    ] .

ga:MemoryAssertionShape
    a sh:NodeShape ;
    sh:targetClass ga:Assertion ;
    sh:or (
        [ sh:not [ sh:path ga:assertionType ; sh:hasValue ga:MemoryAssertion ] ]
        [ sh:path ga:assertsValue ; sh:minCount 1 ;
          sh:in ( ga:AuthorMemory ga:CharacterMemory ga:UndecidableMemory ) ]
    ) ;
    sh:message "Un'asserzione di memoria ha valori dello schema MemoryAttribution." .


# =============================================================================
# SHAPE 12 — Partizioni interpretative (D-050, work order T-37)
# Ogni zona appartiene a una sola partizione; la partizione e' il soggetto di
# un'asserzione attribuita. La regola «un luogo in una sola zona per
# partizione» sta in integrity.rq (IQ15).
# =============================================================================

ga:PartitionZoneShape
    a sh:NodeShape ;
    sh:targetClass ga:PartitionZone ;
    sh:property [
        sh:path [ sh:inversePath ga:hasZone ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Una zona appartiene a una e una sola partizione." ;
    ] .

ga:PartitionShape
    a sh:NodeShape ;
    sh:targetClass ga:Partition ;
    sh:property [
        sh:path [ sh:inversePath ga:aboutSubject ] ;
        sh:minCount 1 ;
        sh:message "Una partizione e' un'ipotesi: serve un'asserzione attribuita che la abbia per soggetto." ;
    ] .

ga:InPartitionZoneShape
    a sh:NodeShape ;
    sh:targetClass ga:NarrativePlace ;
    sh:property [
        sh:path ga:inPartitionZone ;
        sh:class ga:PartitionZone ;
        sh:message "inPartitionZone punta a una zona di una partizione." ;
    ] .


# =============================================================================
# SHAPE 13 — Storia delle revisioni (D-051, work order T-38)
# Una revisione punta a un'asserzione. Stesso soggetto e stesso tipo: IQ16.
# =============================================================================

ga:RevisionShape
    a sh:NodeShape ;
    sh:targetClass ga:Assertion ;
    sh:property [
        sh:path prov:wasRevisionOf ;
        sh:class ga:Assertion ;
        sh:message "prov:wasRevisionOf punta a un'altra asserzione attribuita." ;
    ] .


# =============================================================================
# SHAPE 14 — Opera e testimoni (D-052, work order T-40)
# =============================================================================

ga:WitnessShape
    a sh:NodeShape ;
    sh:targetClass ga:Witness ;
    sh:property [
        sh:path ga:witnessOf ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class ga:LiteraryWork ;
        sh:message "Un testimone e' testimone di una e una sola opera." ;
    ] ;
    sh:property [
        sh:path ga:witnessType ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( ga:PeriodicalRedaction ga:Typescript ga:Proofs ga:FirstEdition ga:Edition ) ;
        sh:message "Un testimone ha un tipo dello schema WitnessType." ;
    ] ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:class ga:Witness ;
        sh:message "Un testimone deriva solo da un altro testimone." ;
    ] .

ga:ReferenceWitnessShape
    a sh:NodeShape ;
    sh:targetClass ga:LiteraryWork ;
    sh:property [
        sh:path ga:referenceWitness ;
        sh:maxCount 1 ;
        sh:class ga:Witness ;
        sh:message "Un'opera ha al piu' un testimone di riferimento." ;
    ] .


# =============================================================================
# SHAPE 15 — Varianti di testimone (D-053, work order T-41)
# Un'asserzione di variante ha per soggetto il luogo e per valori almeno due
# occorrenze (PlaceReference), del testo di riferimento e di altri testimoni.
# =============================================================================

ga:VariantAssertionShape
    a sh:NodeShape ;
    sh:targetClass ga:Assertion ;
    sh:or (
        [ sh:not [ sh:path ga:assertionType ; sh:hasValue ga:VariantAssertion ] ]
        [ sh:and (
            [ sh:path ga:aboutSubject ; sh:class ga:NarrativePlace ]
            [ sh:path ga:assertsValue ; sh:minCount 2 ; sh:class ga:PlaceReference ]
          ) ]
    ) ;
    sh:message "Una variante riguarda un luogo e collega almeno due occorrenze (PlaceReference)." .


# =============================================================================
# SHAPE 16 — Lo statuto e' del luogo (D-054, work order T-42)
# Un'asserzione di statuto ha per soggetto un luogo narrativo, mai
# un'occorrenza o un testimone.
# =============================================================================

ga:StatusSubjectShape
    a sh:NodeShape ;
    sh:targetClass ga:Assertion ;
    sh:or (
        [ sh:not [ sh:path ga:assertionType ; sh:hasValue ga:StatusAssertion ] ]
        [ sh:path ga:aboutSubject ; sh:class ga:NarrativePlace ]
    ) ;
    sh:message "Lo statuto di realta' si asserisce di un luogo narrativo, non di un'occorrenza o di un testimone." .


# =============================================================================
# SHAPE 17 — Ancoraggio relazionale (D-057, work order T-47)
# =============================================================================

ga:RelationalAnchoringShape
    a sh:NodeShape ;
    sh:targetClass ga:RelationalAnchoring ;
    sh:property [
        sh:path ga:relatum ;
        sh:minCount 1 ;
        sh:or ( [ sh:class ga:GazetteerEntity ] [ sh:class ga:NarrativePlace ] ) ;
        sh:message "Un ancoraggio relazionale ha almeno un termine: un'entita' del gazetteer o un luogo narrativo." ;
    ] ;
    sh:property [
        sh:path ga:relationalType ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( ga:Near ga:Between ga:AdjacentTo ga:Above ga:Below ga:Threshold ga:Facing ga:Boundary ) ;
        sh:message "Un ancoraggio relazionale ha un tipo di relazione." ;
    ] ;
    sh:or (
        [ sh:not [ sh:path ga:relationalType ; sh:hasValue ga:Between ] ]
        [ sh:path ga:relatum ; sh:minCount 2 ]
    ) ;
    sh:message "«Tra» richiede almeno due termini." .


# =============================================================================
# SHAPE 18 — Forma attestata (D-059, work order T-48)
# =============================================================================

ga:AttestedFormShape
    a sh:NodeShape ;
    sh:targetClass ga:PlaceReference ;
    sh:property [
        sh:path ga:attestedForm ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "Un'occorrenza ha al piu' una forma attestata." ;
    ] .


# =============================================================================
# SHAPE 19 — Percorsi tipizzati (D-060, work order T-54)
# =============================================================================

ga:RouteTypeAssertionShape
    a sh:NodeShape ;
    sh:targetClass ga:Assertion ;
    sh:or (
        [ sh:not [ sh:path ga:assertionType ; sh:hasValue ga:RouteTypeAssertion ] ]
        [ sh:and (
            [ sh:path ga:aboutSubject ; sh:class ga:NarrativeRoute ]
            [ sh:path ga:assertsValue ; sh:minCount 1 ; sh:maxCount 1 ;
              sh:in ( ga:CompletedRoute ga:IndicatedRoute ga:DreamedRoute
                      ga:InferredRoute ga:DirectionalRoute ga:ProposedRoute ) ]
          ) ]
    ) ;
    sh:message "Un'asserzione di tipo di percorso riguarda un NarrativeRoute e ha un valore dello schema RouteType." .

ga:RouteTypeShape
    a sh:NodeShape ;
    sh:targetClass ga:NarrativeRoute ;
    sh:property [
        sh:path ga:hasRouteType ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Ogni percorso ha un tipo, dalla lettura adottata (D-060)." ;
    ] .


# =============================================================================
# SHAPE 20 — Agenti (D-062)
# Ogni agente del dataset e' una persona, studioso o annotatore.
# =============================================================================

ga:AgentKindShape
    a sh:NodeShape ;
    sh:targetClass prov:Person ;
    sh:or (
        [ sh:class ga:Scholar ]
        [ sh:class ga:Annotator ]
    ) ;
    sh:message "Un agente del dataset e' chora:Scholar o chora:Annotator." .
