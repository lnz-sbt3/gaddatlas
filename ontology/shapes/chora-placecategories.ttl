@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


<https://w3id.org/chora/vocab/placecategory> a owl:Ontology ;
    rdfs:label "GaddAtlas Place Category Vocabulary" ;
    dc:description "Controlled vocabulary of place types used in GaddAtlas." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> .


### https://w3id.org/chora#PlaceCategoryScheme

ga:PlaceCategoryScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    dcterms:title "GaddAtlas Place Category Vocabulary"@en ;
    dcterms:description "Controlled vocabulary of place types used to classify narrative places and gazetteer entities in GaddAtlas. Categories emerged inductively from the close reading of Gadda's \"Quer pasticciaccio brutto de via Merulana\" and are aligned, where possible, to Wikidata and the Getty AAT."@en ;
    dcterms:creator <https://orcid.org/0009-0007-1496-722X> ;
    dcterms:publisher <https://ror.org/01111rn36> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2025-10-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
    dcterms:modified "2026-08-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
    owl:versionInfo "4.1.1" ;
    rdfs:label "Place Category"@en ;
    skos:altLabel "Categoria di luogo"@it ;
    skos:hasTopConcept ga:Church,
        ga:Railway_line,
        ga:apartment,
        ga:aqueduct,
        ga:archaeological_site,
        ga:bank,
        ga:basilica,
        ga:bridge,
        ga:building,
        ga:castle,
        ga:catacombs,
        ga:cemetery,
        ga:city,
        ga:city_gate,
        ga:coast,
        ga:courtyard,
        ga:district,
        ga:fountain,
        ga:frazione,
        ga:gallery,
        ga:gulf,
        ga:hill,
        ga:historical_building,
        ga:hospice,
        ga:hospital,
        ga:hotel,
        ga:house,
        ga:locality,
        ga:monument,
        ga:mountain,
        ga:palace,
        ga:park,
        ga:police_station,
        ga:port,
        ga:prison,
        ga:railway,
        ga:region,
        ga:restaurant,
        ga:river,
        ga:shop,
        ga:small_square,
        ga:small_town,
        ga:sports_complex,
        ga:square,
        ga:station,
        ga:street,
        ga:temple,
        ga:theater,
        ga:villa,
        ga:village,
        ga:interior,
        ga:municipality,
        ga:retail_business,
        ga:ward,
        ga:cafe,
        ga:dwelling,
        ga:farmhouse,
        ga:kitchen_garden,
        ga:level_crossing,
        ga:railway_gatehouse,
        ga:road,
        ga:road_junction,
        ga:room,
        ga:shrine ;
    skos:prefLabel "Place Category"@en .



